@typeparam T where T : struct, System.Numerics.INumber<T>

<MudStack Spacing="2" Class="pa-4">

    @if (ShowPerSliderValues)
    {
        <MudText Typo="Typo.body1">
            <b>From:</b> @FormatValue(MinValue)
        </MudText>
    }

    <div class="range-dual-container" style="--track-h: @(TrackHeightPx)px;">

        <div class="track-bg"></div>

        @if (ShowBand)
        {
            <div class="track-fill" style="@FillStyle"></div>
        }

        <input type="range"
               min="@Min"
               max="@Max"
               step="@Step"
               @bind="MinValueInternal"
               @bind:event="oninput"
               class="thumb thumb-min" />

        <input type="range"
               min="@Min"
               max="@Max"
               step="@Step"
               @bind="MaxValueInternal"
               @bind:event="oninput"
               class="thumb thumb-max" />

        <div class="tooltip" style="left:@LeftPercent%;">@FormatValue(MinValue)</div>
        <div class="tooltip" style="left:@RightPercent%;">@FormatValue(MaxValue)</div>
    </div>

    @if (ShowPerSliderValues)
    {
        <MudText Typo="Typo.body1">
            <b>To:</b> @FormatValue(MaxValue)
        </MudText>
    }

    @if (ShowRangeSummary)
    {
        <MudText Align="Align.Center" Typo="Typo.body1">
            Delta Range: @FormatValue(MinValue) – @FormatValue(MaxValue)
        </MudText>
    }
</MudStack>

<style>
    .range-dual-container {
        position: relative;
        height: 70px;
        margin: 20px 8px;
    }

    .track-bg, .track-fill {
        position: absolute;
        top: 50%;
        height: var(--track-h);
        border-radius: calc(var(--track-h) / 2);
        transform: translateY(-50%);
        transition: all 0.2s ease;
    }

    .track-bg {
        width: 100%;
        background: var(--mud-palette-lines-default);
    }

    .track-fill {
        background: var(--mud-palette-primary);
    }

    .thumb {
        position: absolute;
        width: 100%;
        height: 100%;
        background: transparent;
        pointer-events: none;
        -webkit-appearance: none;
    }

        .thumb::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 32px;
            width: 32px;
            border-radius: 50%;
            background: white;
            border: 5px solid var(--mud-palette-primary);
            cursor: grab;
            pointer-events: auto;
            box-shadow: 0 4px 16px rgba(0,0,0,0.3);
            transition: all 0.2s;
        }

        .thumb:hover::-webkit-slider-thumb,
        .thumb:active::-webkit-slider-thumb {
            transform: scale(1.2);
            box-shadow: 0 8px 32px rgba(0,0,0,0.4);
            cursor: grabbing;
        }

    .thumb-min::-webkit-slider-thumb {
        border-color: #1976d2;
    }

    .thumb-max::-webkit-slider-thumb {
        border-color: #388e3c;
    }

    .tooltip {
        position: absolute;
        top: -44px;
        transform: translateX(-50%);
        background: #1e1e1e;
        color: white;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
        box-shadow: 0 4px 16px rgba(0,0,0,0.4);
    }

        .tooltip::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 50%;
            transform: translateX(-50%);
            border: 6px solid transparent;
            border-top-color: #1e1e1e;
        }
</style>