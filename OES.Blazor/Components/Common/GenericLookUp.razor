
@typeparam T

<MudCard>

    <MudCardContent>
        <MudExpansionPanel Style="border: 1px solid #ccc; border-radius: 8px; box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);">
            <TitleContent>
                <MudText Typo="Typo.h6">@Title</MudText>
            </TitleContent>
            <ChildContent>
                @foreach (var property in GetProperties(item))
                {
                    @if (property.Name == "Name")
                    {
                        <MudTextField T="string" Label="Name" @bind-Value="property.Description" Variant="Variant.Outlined" />
                    }
                    else if (property.Name == "Description")
                    {
                        <MudTextField T="string" Label="Description" @bind-Value="property.Description" Variant="Variant.Outlined" />
                    }
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudCardContent>

    <MudCardActions Style="width: 100%; display: flex; justify-content: center;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveData" Style="width: 100%;">
            Save
        </MudButton>
    </MudCardActions>

</MudCard>



