@using OES.Blazor.InternalHelperTypes.General

<div class="@(ScreenSizeClass)" data-no-convert dir="@DirectionHelper.GetDirection()">
    <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="responsive-container d-flex flex-column">
        <MudGrid Spacing="0" Class="@($"sun-editor-editable question-watermark-transparent {DirectionHelper.GetQuestionBodyClass()}")">
            <MudItem xs="@ColumnsCount" data-no-convert>
                <div style="max-height: 85vh; overflow-y: auto;">
                    <MudText Typo="Typo.inherit" Align="Align.Start" data-no-convert>@DirectionHelper.GetDirectionalContent(QuestionHeader.ToString())</MudText>
                    @if (HasAttachment)
                    {
                        <MediaAttachment Url="@(AttachmentFileUrl)" />
                    }
                </div>
            </MudItem>

            @* <MudAlert Severity="Severity.Info" Elevation="0" Dense Class="mt-4">
                <MudText Typo="Typo.subtitle1">@QuestionInstructions</MudText>
            </MudAlert> *@

            <MudItem xs="12">
                <div style="max-height: 85vh; overflow-y: auto;">
                    <div class="d-flex flex-wrap w-100">
                        @foreach (var option in Options)
                        {
                            <div style="@OptionWidthStyle" class="p-2">
                                <div class="d-flex flex-column">
                                    <MudStack Row="true">
                                        <MudCheckBox T="bool"
                                                     Color="Color.Primary"
                                                     Size="Size.Small"
                                                     Value="@(ShowCorrectAnswer ? option.IsCorrectAnswer : false)"
                                                     ReadOnly
                                                     Class="ms-2 align-start-checkbox"
                                                     Style="flex: none; margin: 0; padding: 0; display: flex; justify-content: center; align-items: center;">
                                            <MudText Typo="Typo.subtitle1" Align="Align.Start" Class="ms-2" data-no-convert>
                                                @(new MarkupString(option.ChoiceText))
                                            </MudText>
                                        </MudCheckBox>
                                        @if (option.HasAttachment)
                                        {
                                            <MediaAttachment Url="@option.AttachmentFileUrl" ImageStyle="max-width:200px; height:auto; border-radius:4px;" />
                                        }
                                    </MudStack>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>
</div>
