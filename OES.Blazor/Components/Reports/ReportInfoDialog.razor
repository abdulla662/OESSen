
<MudDialog>
    <TitleContent>
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Info" />
            <MudText Typo="Typo.h6">@Title</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4" Style="color:#555">@Overview</MudText>
        @foreach (var infoSec in Sections)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mt-3 mb-1">
                <strong>@infoSec.Heading</strong>
            </MudText>
            <MudDivider Class="mb-2" />
            @foreach (var item in infoSec.Items)
            {
                <div class="mb-2 ps-1">
                    <MudText Typo="Typo.body2">
                        <strong>@item.Label</strong><MudText Inline="true" Typo="Typo.body2" Style="color:#555"> — @item.Description</MudText>
                    </MudText>
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Close">Close</MudButton>
    </DialogActions>
</MudDialog>
