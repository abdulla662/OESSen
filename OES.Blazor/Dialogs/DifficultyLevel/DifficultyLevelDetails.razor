@using OES.Helper.ResourceFiles
@using System.Globalization

<MudDialog Class="pa-5">
    <TitleContent>
        <div class="d-flex align-center justify-center mt-5">
            <div class="d-flex align-center justify-center align-self-center pa-3 w-75"
                 style="border-radius: 8px;" dir="@(RightToLeft ? "rtl" : "ltr")">
                <MudIcon Icon="@Icons.Material.Rounded.FilePresent" Class="me-2" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h4" Color="Color.Primary" Class="font-weight-bold">@Resource.DifficultyLevelDetails</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (Model != null)
        {
            <MudGrid Spacing="4" Class="animate__animated animate__fadeIn py-3">
                <!-- Basic Information Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3 font-weight-bold">
                            <MudIcon Color="Color.Secondary" Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                            @Resource.GeneralInformation
                        </MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Label" Color="Color.Secondary" />
                                    <MudText Color="Color.Primary" Typo="Typo.subtitle2">
                                        <strong>@Resource.Name:</strong>
                                    </MudText>
                                    <MudText Class="ml-2">@Model.Name</MudText>
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Secondary" />
                                    <MudText Color="Color.Primary" Typo="Typo.subtitle2">
                                        <strong>@Resource.DifficultyProfileName:</strong>
                                    </MudText>
                                    <MudText Class="ml-2">@Model.DifficultyProfileName</MudText>
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Secondary" />
                                    <MudText Color="Color.Primary" Typo="Typo.subtitle2">
                                        <strong>@Resource.DeltaType:</strong>
                                    </MudText>
                                    <MudText Class="ml-2">@Model.DeltaTypeName</MudText>
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Secondary" />
                                    <MudText Color="Color.Primary" Typo="Typo.subtitle2">
                                        <strong>@Resource.DifficultyProfileDescrption:</strong>
                                    </MudText>
                                    <MudText Class="ml-2">@Model.DifficultyProfileDescription</MudText>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>

                <!-- Delta Range Section -->
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3 font-weight-bold">
                            <MudIcon Color="Color.Secondary" Icon="@Icons.Material.Filled.Timeline" Class="mr-2" />
                            @Resource.DeltaRange
                        </MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="5">
                                <MudPaper Class="pa-3 text-center" Elevation="1">
                                    <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Start" Color="Color.Secondary" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-medium">
                                            @Resource.FromDelta
                                        </MudText>
                                        <MudText Typo="Typo.h5" Class="font-weight-bold">
                                            @Model.FromDeltaFormatted
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="2" Class="d-flex justify-content-center align-items-center">
                                <MudIcon Icon="@(RightToLeft ? Icons.Material.Filled.ArrowBack : Icons.Material.Filled.ArrowForward)"
                                         Color="Color.Secondary"
                                         Size="Size.Large" />
                            </MudItem>

                            <MudItem xs="12" sm="5">
                                <MudPaper Class="pa-3 text-center" Elevation="1">
                                    <MudStack Spacing="2" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Flag" Color="Color.Secondary" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-medium">
                                            @Resource.ToDelta
                                        </MudText>
                                        <MudText Typo="Typo.h5" Class="font-weight-bold">
                                            @Model.ToDeltaFormatted
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudText Color="Color.Error" Typo="Typo.body1">No data available</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Close" StartIcon="@Icons.Material.Filled.Close">
            @Resource.Close
        </MudButton>
    </DialogActions>
</MudDialog>
