<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@Resource.AreYouSureYouWantToDeleteThisDocument</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm" EndIcon="@Icons.Material.Filled.Delete">
            @Resource.Delete
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" EndIcon="@Icons.Material.Filled.Cancel">
            @Resource.Cancel
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel() => MudDialog.Cancel();

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}
