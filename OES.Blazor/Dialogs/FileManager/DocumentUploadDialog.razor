<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Custom.FileFormats.FileDocument" Class="mr-3" /> @Resource.UploadFile
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Style="width: 100%">
            <MudFileUpload T="IBrowserFile"
                           @ref="@_mudFileUploadComponent"
                           OnFilesChanged="OnInputFileChanged"
                           Hidden="@false"
                           InputClass="absolute mud-width-full mud-height-full overflow-hidden z-10"
                           InputStyle="opacity:0"
                           @ondrop="@ClearDragClass"
                           @ondragenter="@SetDragClass"
                           @ondragleave="@ClearDragClass"
                           @ondragend="@ClearDragClass">
            <ActivatorContent>
                <MudPaper Height="300px"
                          Outlined="true"
                          Class="@_dragClass">
                    <MudText Typo="Typo.h6">
                        @Resource.DragAndDropAFileHereOrClick
                    </MudText>
                    @if (_fileToUpload != null)
                    {
                        <MudChip T="string"
                                 Color="Color.Dark"
                                 Text="@_fileToUpload.Name" />
                    }
                </MudPaper>
            </ActivatorContent>
            </MudFileUpload>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudToolBar Gutters="@false" Class="relative d-flex justify-end gap-4">
            <MudButton Color="Color.Primary"
                       Disabled="_fileToUpload == null || _processing"
                       OnClick="@UploadFileAsync"
                       Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.Upload">
                @if (_processing)
                {
                    @(@Resource.Processing)
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="ms-2" />
                }
                else
                {
                    @(Resource.Upload)
                }
            </MudButton>
            <MudButton Color="Color.Primary"
                       Disabled="_fileToUpload == null"
                       OnClick="@ClearAsync"
                       Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.Clear">
               @Resource.Clear
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="Close"
                       EndIcon="@Icons.Material.Filled.Cancel">
                @Resource.Close
            </MudButton>
        </MudToolBar>
    </DialogActions>
</MudDialog>