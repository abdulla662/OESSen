@namespace OES.Blazor.Pages.AIItemBankGenerator.Dialogs
@using OES.Helper.Dtos.ItemBank
@using OES.Helper.ResourceFiles

<MudDialog>
    <TitleContent>
        <div class="d-flex justify-space-between align-center w-100">
            <MudText Typo="Typo.h5" Color="Color.Primary">
                @Resource.ItemBankTemplate
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Close" Class=@($"label-{nameof(Resource.Close)}") />
        </div>
    </TitleContent>
    <DialogContent>
        <ListItem T="ItemBankTemplateDto"
                  FilterObject="false"
                  @key="listChangingKey"
                  EndpointServerice="@(pagination => BlazItemBankService.GetAllItemBankTemplateAsync(new ItemBankPaginationSearchRequest(pagination, IsFromItemBankAI)))"
                  DisplayColumns='["Name"]'
                  Hide_DescriptionSearch="true"
                  CRUD_Delete_Btn="true"
                  DeleteClick_fun="DeleteItemBankTemplateAsync"
                  SearchPanelVisible="false">
            <ButtonChildContent Context="value">
                <MudTooltip Text="@Resource.SelectTemplate">
                    <MudFab Color="Color.Primary" EndIcon="@Icons.Material.Filled.SelectAll" Class=@($"label-{nameof(Resource.SelectTemplate)}") Size="Size.Small" @onclick='() => GetTemplateById(((ItemBankTemplateDto)value).Id)' />
                </MudTooltip>
            </ButtonChildContent>
        </ListItem>
    </DialogContent>
</MudDialog>
