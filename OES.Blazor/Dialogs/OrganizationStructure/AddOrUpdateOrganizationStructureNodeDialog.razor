
<EditForm Model="@Model" OnValidSubmit="SubmitAsync">
    <MudDialog>
        <DialogContent>
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="Model.Name" 
                          Label="@Resource.Name" 
                          Variant="Variant.Outlined" 
                          HelperTextOnFocus="true"
                          HelperText="@Resource.OrgRootName"
                          For="@(() => Model.Name)"
                          Required="true" />
            <MudTextField @bind-Value="Model.Description" 
                          Label="@Resource.Description"
                          Variant="Variant.Outlined" 
                          HelperTextOnFocus="true"
                          HelperText="@Resource.OrgRootDescription"
                          Lines="3"
                          For="@(() => Model.Description)"
                          Required="true" />
            <MudCheckBox @bind-Value="Model.IsLeaf" 
                         Label="@Resource.IsLeafNode"
                         Color="Color.Primary"
                         For="@(() => Model.IsLeaf)" />
        </DialogContent>
        <DialogActions>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.CheckCircle">
                @(IsUpdateMode ? Resource.Update : Resource.Add)
            </MudButton>
            <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="Cancel" EndIcon="@Icons.Material.Filled.Cancel">@Resource.Cancel</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>