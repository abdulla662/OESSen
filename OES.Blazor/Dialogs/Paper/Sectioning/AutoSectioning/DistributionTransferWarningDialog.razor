@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Color="@Color" />
            Warning
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="@Color" OnClick="Confirm" EndIcon="@Icons.Material.Filled.CheckCircle">@ButtonText</MudButton>
    </DialogActions>
</MudDialog>