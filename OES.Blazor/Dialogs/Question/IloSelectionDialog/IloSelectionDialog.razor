@using OES.Blazor.Components.GenericComponents.TreeViewTemplates.GrpcTreeViewTemplate

<MudDialog>
    <TitleContent>
        <h4>@Resource.SelectILONode</h4>
    </TitleContent>
    <DialogContent>
        <GrpcTreeViewTemplate @key="_treeViewKey"
                              Items="@Items"
                              SelectedItemId="SelectedIloNodeId"
                              IsSingleSelectionTree="true"
                              GetSelectedTreeItem="GetSelectedTreeItem" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="SelectedTreeItem == null" EndIcon="@Icons.Material.Filled.CheckCircle">@Resource.Submit</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" EndIcon="@Icons.Material.Filled.Cancel">@Resource.Cancel</MudButton>
    </DialogActions>
</MudDialog>