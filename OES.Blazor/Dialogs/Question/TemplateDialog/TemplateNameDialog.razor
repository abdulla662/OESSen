<MudDialog TitleClass="fw-bold font-weight-bold" Gutters="true" Style="border:1px solid var(--mud-palette-divider)">
    <DialogContent>
        <MudTextField 
            @bind-Value="TemplateName"             
            Placeholder="@Resource.EnterTemplateName"
            Variant="Variant.Outlined"
            Error="@IsTemplateNameInvalid"  
            ErrorText="@TemplateNameErrorText"
            Class="mb-4" />
    </DialogContent>
    <DialogActions>
        <MudButton
            OnClick="SaveTemplateName"
            Color="Color.Primary"
            Variant="Variant.Filled"
            EndIcon="@Icons.Material.Filled.CheckCircle">
            @Resource.Save
        </MudButton>
        <MudButton
            OnClick="Cancel"
            Color="Color.Secondary"
            Variant="Variant.Filled"
            EndIcon="@Icons.Material.Filled.Cancel">
            @Resource.Cancel
        </MudButton>
    </DialogActions>
</MudDialog>