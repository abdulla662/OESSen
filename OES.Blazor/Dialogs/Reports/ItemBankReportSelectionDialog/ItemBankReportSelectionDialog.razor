@using OES.Blazor.Components.GenericComponents.TreeViewTemplates.GrpcTreeViewTemplate

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @Resource.RptFilterItemBank
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true"
                                 Color="Color.Primary"
                                 Class="d-block mx-auto my-8" />
        }
        else
        {
            <GrpcTreeViewTemplate @key="_treeKey"
                                  Items="_treeItems"
                                  IsSingleSelectionTree="true"
                                  ShowSearchBar="true"
                                  TreeCrudButtonsRolesPlaceholders="TreeRoles"
                                  GetSelectedTreeItem="OnItemSelected" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(_selectedItem is null)"
                   OnClick="Submit"
                   EndIcon="@Icons.Material.Filled.CheckCircle">
            @Resource.Select
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   OnClick="Cancel"
                   EndIcon="@Icons.Material.Filled.Cancel">
            @Resource.Cancel
        </MudButton>
    </DialogActions>
</MudDialog>