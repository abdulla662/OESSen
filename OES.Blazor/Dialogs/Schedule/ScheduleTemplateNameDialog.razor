<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Primary" Class="mt-5">
            @Resource.SaveAsScheduleTemplate
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_templateName"
                      Label="@Resource.TemplateName"
                      Variant="Variant.Outlined"
                      Required
                      Immediate
                      Error="@(_isSubmitButtonHit && string.IsNullOrWhiteSpace(_templateName))"
                      ErrorText="Template name is required" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="SaveTemplate" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.CheckCircle">@Resource.Save</MudButton>
        <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Secondary" EndIcon="@Icons.Material.Filled.Cancel">@Resource.Cancel</MudButton>
    </DialogActions>
</MudDialog>