@using MudBlazor
@using OES.Blazor.Components.GenericComponents.TreeViewTemplates.AIItemBankTreeViewTemplate
@using OES.Helper.Dtos.ItemBank
@using OES.Helper.ResourceFiles

@if (GeneratedTree != null)
{
    <MudPaper Class="pa-4" Elevation="0">

        @* Warning / Info Banner *@
        <div class="d-flex align-center gap-3 py-3 px-4 mb-4"
             style="border: 1px solid #ffe0b2;
                    border-inline-start: 5px solid #ff9800;
                    background-color: #ffffff;
                    border-radius: 4px;">
            <MudIcon Icon="@Icons.Material.Filled.Warning"
                     Style="color: #ff9800; flex-shrink: 0;"
                     Size="Size.Medium" />
            <MudText Typo="Typo.body2"
                     Style="color: #e65100; font-weight: 500;">
                @Resource.ItemBankReviewStepWarning
            </MudText>
        </div>

        @* Header *@
        <div class="d-flex align-center justify-space-between mb-4">
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree"
                         Color="Color.Primary"
                         Size="Size.Medium" />
                <MudText Typo="Typo.h6"
                         Color="Color.Primary">
                    @Resource.TreePreview
                </MudText>
            </MudStack>
        </div>

        @* Item Bank Tree *@
        <ItemBankTreeViewTemplate RootNode="@GeneratedTree"
                                  @bind-SelectedNode="_selectedNode"
                                  InsertionButtonShown="true"
                                  UpdateButtonShown="true"
                                  DeletionButtonShown="true"
                                  MoveButtonShown="true"
                                  ShowSearchBar="true"
                                  IsReadOnly="@(_isSaving || IsConfigurationLocked)"
                                  InsertTreeItem="@AddChildNodeAsync"
                                  UpdateTreeItem="@EditNodeAsync"
                                  RemoveTreeItem="@DeleteNodeAsync"
                                  MoveTreeItem="@PrepareMoveNodeAsync" />

        @* Move Node Section *@
        @if (_nodeToMove != null)
        {
            <MudPaper id="move-node-section"
                      Elevation="0"
                      Class="pa-3 mt-4"
                      Style="border: 1px solid var(--mud-palette-lines-default); border-radius: 8px;">
                <div class="d-flex align-center justify-space-between gap-3">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Color="Color.Info" />
                        <div>
                            <MudText Typo="Typo.body2" Class="fw-bold">
                                @Resource.Move @_nodeToMove.Name
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @Resource.EnterTargetParentNodeNumber
                            </MudText>
                        </div>
                    </div>

                    <div class="d-flex align-center gap-2">
                        <MudNumericField T="int?"
                                         @bind-Value="_moveTargetNumber"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Placeholder="@Resource.NodeNumberPlaceholder"
                                         Style="width: 110px;" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.DriveFileMove"
                                   OnClick="@MoveSelectedNode">
                            @Resource.Move
                        </MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Default"
                                       OnClick="@CancelMove" />
                    </div>
                </div>
            </MudPaper>
        }

        @* Save Button *@
        <div class="d-flex justify-center mt-6">
            <MudButton Variant="Variant.Filled"
                       Color="@(IsConfigurationLocked ? Color.Default : Color.Success)"
                       Size="Size.Large"
                       Style="min-width: 250px; border-radius: 8px;"
                       StartIcon="@(_isSaving ? null : IsConfigurationLocked ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Save)"
                       OnClick="@SaveItemBankTreeAsync"
                       Disabled="@(_isSaving || IsConfigurationLocked)">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true"
                                         Class="me-2" />
                }
                @(IsConfigurationLocked? Resource.ItemBankSavedSuccessfully: Resource.SaveItemBankTree)
            </MudButton>
        </div>

    </MudPaper>
}
else
{
    <MudPaper Class="pa-6 d-flex flex-column align-center justify-center"
              Elevation="0"
              Style="min-height: 200px;">
        <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                 Size="Size.Large"
                 Color="Color.Secondary"
                 Class="mb-3" />
        <MudText Typo="Typo.h6"
                 Color="Color.Secondary">
            @Resource.NoItemBankFound
        </MudText>
    </MudPaper>
}