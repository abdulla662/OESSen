@page "/AIQuestionGenerator"

@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using MudExtensions
@using MudExtensions.Utilities
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Blazor.Pages.AIQuestionGenerator.FirstStep
@using OES.Blazor.Pages.AIQuestionGenerator.FourthStep
@using OES.Blazor.Pages.AIQuestionGenerator.SecondStep
@using OES.Blazor.Pages.AIQuestionGenerator.ThirdStep
@using OES.Helper.ResourceFiles

@attribute [DynamicAuthorizeAttribute(nameof(AIQuestionGenerator))]

<PageTitle>@Resource.AIQuestionGenerator</PageTitle>

<MudItem Class="mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <div class="d-flex justify-content-center align-items-center my-5">
        <MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" Color="Color.Primary" Size="Size.Large" Class="me-3" Style="vertical-align: middle;" />
        <MudText Typo="Typo.h4" Align="Align.Center" Color="Color.Primary" Style="line-height: 1;">@Resource.AIQuestionGenerator</MudText>
    </div>

    <MudStepperExtended @ref="_stepper"
                        Class="mud-width-full"
                        ContentStyle="min-height: 400px"
                        Linear="@_linear"
                        Vertical="@_vertical"
                        PreventStepChangeAsync="CheckChangeAsync"
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        MobileView="@_mobileView"
                        Loading="@_loading"
                        LocalizedStrings="GetLocalizedStrings()"
                        @bind-ShowPreviousButton="_showPreviousButton"
                        @bind-ShowNextButton="_showNextButton"
                        ActiveStepChanged="OnActiveStepChanged"
                        HeaderTextView="HeaderTextView.All"
                        ShowStepResultIndicator="false">
        <ChildContent>

            <MudStepExtended Icon="@Icons.Material.Filled.Settings" Title="@Resource.QuestionConfiguration">
                <ChildContent>
                    <ConfigurationStep @ref="_configurationStepComponent" IsConfigurationLocked="IsConfigurationStepLocked" IsSubmitButtonHit="_isSubmitButtonHit" />
                </ChildContent>
            </MudStepExtended>

            <MudStepExtended Icon="@Icons.Material.Filled.Memory" Title="@Resource.QuestionGeneration">
                <ChildContent>
                    <GenerateStep ConfigurationData="_configurationData" OnGenerated="OnQuestionsGenerated" IsConfigurationLocked="_isConfigurationLocked" OnProcessingStateChanged="OnGeneratingStateChanged" />
                </ChildContent>
            </MudStepExtended>

            <MudStepExtended Icon="@Icons.Material.Filled.RateReview" Title="@Resource.Review">
                <ChildContent>
                    <ReviewStep GeneratedQuestions="_generatedQuestions" @bind-IsConfigurationLocked="_isConfigurationLocked" />
                </ChildContent>
            </MudStepExtended>

            <MudStepExtended Icon="@Icons.Material.Filled.Done" Title="@Resource.Finish" IsResultStep="true">
                <ChildContent>
                    <CompleteStep />
                </ChildContent>
            </MudStepExtended>

        </ChildContent>
    </MudStepperExtended>
</MudItem>
