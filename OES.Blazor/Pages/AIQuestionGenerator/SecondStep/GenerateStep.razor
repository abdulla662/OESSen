@using MudBlazor
@using OES.Helper
@using OES.Helper.Enums
@using OES.Helper.ResourceFiles

<MudGrid Spacing="3">
    @* Configuration Summary Section *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1" Outlined="true">
            <div class="d-flex align-center gap-2 mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Summarize" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@Resource.Summary</MudText>
            </div>

            <MudGrid Spacing="2">
                @* File Info *@
                <MudItem xs="12" sm="6" md="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Resource.File</MudText>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 200px;">
                                @(ConfigurationData.File?.Name ?? "-")
                            </MudText>
                        </div>
                    </MudStack>
                </MudItem>

                @* Subject *@
                <MudItem xs="12" sm="6" md="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Resource.Subject</MudText>
                        <MudText Typo="Typo.body2">@(ConfigurationData.SelectedSubject?.Name ?? "-")</MudText>
                    </MudStack>
                </MudItem>

                @* Category *@
                <MudItem xs="12" sm="6" md="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Resource.Category</MudText>
                        <MudText Typo="Typo.body2">@(ConfigurationData.SelectedCategory?.Name ?? "-")</MudText>
                    </MudStack>
                </MudItem>

                @* Language *@
                <MudItem xs="12" sm="6" md="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Resource.LanguageName</MudText>
                        <MudText Typo="Typo.body2">@(ConfigurationData.SelectedLanguage?.Name ?? "-")</MudText>
                    </MudStack>
                </MudItem>

                @* Difficulty Profile *@
                <MudItem xs="12" sm="6" md="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Resource.DifficultyProfile</MudText>
                        <MudText Typo="Typo.body2">@(ConfigurationData.SelectedDifficultyProfile?.Name ?? "-")</MudText>
                    </MudStack>
                </MudItem>

                @* Item Bank *@
                <MudItem xs="12" sm="6" md="4">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Resource.ItemBank</MudText>
                        <MudText Typo="Typo.body2">@(ConfigurationData.SelectedItemBank?.Name ?? "-")</MudText>
                    </MudStack>
                </MudItem>

                @* ILO (Optional) *@
                @if (ConfigurationData.SelectedIlo?.Id > 0)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Resource.ILO</MudText>
                            <MudText Typo="Typo.body2">@(ConfigurationData.SelectedIlo?.Name ?? "-")</MudText>
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    </MudItem>

    @* Question Types Distribution *@
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="1" Outlined="true">
            <div class="d-flex align-center gap-2 mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Quiz" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@Resource.QuestionTypeAndCount</MudText>
                <MudSpacer />
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                    @GetFormattedQuestionsCount(TotalRequestedQuestions)
                </MudChip>
            </div>

            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-2">
                @foreach (var questionType in ConfigurationData.QuestionTypeRequests)
                {
                    <MudChip T="string"
                             Color="Color.Default"
                             Variant="Variant.Filled"
                             Size="Size.Medium"
                             Icon="@GetQuestionTypeIcon(questionType.QuestionTypeName)">
                        @(questionType.QuestionTypeName.ToLocalizedString<OES.Helper.Enums.QuestionType>()): @questionType.Count
                    </MudChip>
                }
            </MudStack>
        </MudPaper>
    </MudItem>

    @* Generation Action Section *@
    <MudItem xs="12">
        <MudPaper Class="pa-6" Elevation="2" Style="background: linear-gradient(135deg, var(--mud-palette-background-grey) 0%, var(--mud-palette-surface) 100%);">
            <div class="d-flex flex-column align-center justify-center" style="min-height: 200px;">
                @if (IsProcessing)
                {
                    <MudStack AlignItems="AlignItems.Center" Spacing="4">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" StrokeWidth="4" />
                        <MudText Typo="Typo.h6" Color="Color.Primary">@Resource.GeneratingQuestionsAI</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            @_processingMessage
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.Stop"
                                   OnClick="CancelGeneration"
                                   Class="mt-2">
                            @Resource.CancelGeneration
                        </MudButton>
                    </MudStack>
                }
                else if (GenerationComplete)
                {
                    <MudStack AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Style="font-size: 4rem;" />
                        <MudText Typo="Typo.h5" Color="Color.Success">@Resource.QuestionsGeneratedSuccess</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @GetFormattedQuestionsCount(TotalGeneratedQuestions)
                        </MudText>
                    </MudStack>
                }
                else
                {
                    <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="w-100">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Large" Style="font-size: 3rem;" />
                        <MudText Typo="Typo.h6" Align="Align.Center">
                            @Resource.AIQuestionGenerator
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   OnClick="GenerateQuestions"
                                   Class="mt-3 px-6">
                            @Resource.Generate
                        </MudButton>
                    </MudStack>
                }
            </div>

            <MudAlert Severity="Severity.Warning"
                      Variant="Variant.Outlined"
                      Dense="true"
                      Class="mt-6 mx-auto rounded-lg"
                      Style="text-align: start; max-width: 600px;">
                <MudText Typo="Typo.caption" Style="font-weight: 500; line-height: 1.5;">
                    @Resource.AIGenerationLimitWarning
                </MudText>
            </MudAlert>
        </MudPaper>
    </MudItem>
</MudGrid>
