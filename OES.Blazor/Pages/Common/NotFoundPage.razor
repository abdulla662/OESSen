
<MudContainer Class="d-flex align-center justify-center notfound-container">
    <MudCard Class="notfound-card" Elevation="6">
        <MudCardContent Class="text-center pa-4 pa-sm-6">
            <MudContainer Class="d-flex align-center justify-center notfound-icon-container">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    <MudIcon Icon="@Icons.Material.Filled.WrongLocation" Size="Size.Large" Title="@Resource.NotFoundPageTitle" />
                </MudText>
            </MudContainer>
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="notfound-title">
                @Resource.NotFoundPageTitle
            </MudText>
            <MudText Typo="Typo.body1" Class="notfound-description">
                @Resource.NotFoundPageDescription
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>