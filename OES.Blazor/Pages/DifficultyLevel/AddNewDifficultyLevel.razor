@page "/AddDifficultyLevel"

@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.DifficultyProfile
@using System.Globalization

@attribute [DynamicAuthorizeAttribute("DifficultyLevelList")]

<PageTitle>@Resource.createDifficultyLevel</PageTitle>

<EditForm Model="@Model">
    <DataAnnotationsValidator />

    <MudCard Class="mx-auto mt-5 w-80 p-4 shadow-lg justify-content-center">
        <MudCardContent>

            <div class="form-group d-flex justify-content-center align-items-center mb-6">
                <MudIcon Icon="@Icons.Material.Rounded.FilePresent" Color="Color.Primary" Class="me-2" Style="vertical-align: middle;" />
                <MudText Color="Color.Primary" Typo="Typo.h5" Style="line-height: 1;">
                    @Resource.createDifficultyLevel
                </MudText>
            </div>

            <div class="form-group">
                <MudTextField Label="@Resource.Name"
                              Required="true"
                              Immediate="true"
                              @bind-Value="Model.Name"
                              Class="mb-3"
                              For="@(() => Model.Name)"
                              Variant="Variant.Outlined" />
            </div>

            <div class="form-group">
                <MudSelect @bind-Value="SelectedDeltaType"
                           Label="@Resource.DeltaType"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var deltaType in FetchedDeltaTypes)
                    {
                        <MudSelectItem Value="@deltaType">@deltaType.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div class="form-group">
                <MudNumericField T="decimal"
                                 Label="@Resource.FromDelta"
                                 Immediate="true"
                                 Required="true"
                                 @bind-Value="Model.FromDelta"
                                 For="@(() => Model.FromDelta)"
                                 Class="mb-3"
                                 Variant="Variant.Outlined"
                                 Max="1.0m"
                                 Culture="@(CultureInfo.InvariantCulture)" />
            </div>

            <div class="form-group">
                <MudNumericField T="decimal"
                                 Label="@Resource.ToDelta"
                                 Immediate="true"
                                 Required="true"
                                 @bind-Value="Model.ToDelta"
                                 For="@(() => Model.ToDelta)"
                                 Class="mb-3"
                                 Variant="Variant.Outlined"
                                 Max="1.0m"
                                 Culture="@(CultureInfo.InvariantCulture)" />
            </div>

            <div class="form-group d-flex">
                <MudAutocomplete T="ProfileDto"
                                 Required="true"
                                 @key="FetchedProfiles"
                                 Label="@Resource.SelectDifficultyProfile"
                                 Value="SelectedProfile"
                                 ValueChanged="GetSelectedProfile"
                                 Variant="Variant.Outlined"
                                 SearchFunc="@SearchDifficultyLevelProfileAsync"
                                 ToStringFunc="@(e => e == null ? null : $"{e.Name}")"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="false"
                                 Immediate="true"
                                 Clearable="true" />
            </div>

            <MudCardActions Class="justify-content-center mt-2">
                <MudStack Row="true"
                          Spacing="4"
                          Class="w-50"
                          Justify="Justify.Center"
                          AlignItems="AlignItems.Center">
                    <GeneralLoadingButton ButtonText="@Resource.Save"
                                          Size="Size.Small"
                                          Class="flex-grow-1 p-2 rounded-pill"
                                          EndIcon="@Icons.Material.Filled.CheckCircle"
                                          Type="ButtonType.Submit"
                                          OnClick="OnSubmitAsync"
                                          Disabled="@(IsSubmitButtonDisabled)" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               Class="flex-grow-1 p-2 rounded-pill"
                               OnClick="Cancel"
                               EndIcon="@Icons.Material.Filled.Cancel">
                        @Resource.Cancel
                    </MudButton>
                </MudStack>
            </MudCardActions>
        </MudCardContent>
    </MudCard>
</EditForm>