@page "/DifficultyLevel"

@using OES.Blazor.Services.Interfaces.DifficultyLevel
@using OES.Helper.Dtos.DifficultyLevel
@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.General
@using OES.Helper.General.ProtectedEntityHelper
@using OES.Blazor.Components.GenericComponents.SettingToggle

@inject IBlazDifficultyLevelService _BlazDifficultyLevelService

@attribute [DynamicAuthorizeAttribute("DifficultyLevelList")]

<PageTitle>@Resource.DifficultyLevels</PageTitle>

<MudCard Class="mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.FilePresent" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.DifficultyLevels</MudText>
        </MudStack>

        <ListItem T="DifficultyLevelDto"
                  @key="_difficultyLevelsListChangingKey"
                  Caption="@Resource.DifficultyLevel"
                  CaptionIcon="@Icons.Material.Rounded.FilePresent"
                  EndpointServerice="_BlazDifficultyLevelService.PaginatedDifficultyLevel"
                  DisplayColumns=@_displayColumnNames
                  AddNew_URL="/AddDifficultyLevel"
                  AddNew_URL_OesRolesList="[OesTemplateRoleConstants.DifficultyLevelCreator]"
                  HideCodeSearch="true"
                  SecondSearchParameterLabel="@Resource.Name">
            <ButtonChildContent Context="value">
                @if (value is DifficultyLevelDto difficultyLevel)
                {
                    <SettingToggle OperationsText="@Resource.Operations">
                        <MudTooltip Text="@Resource.View">
                            <MudFab Color="Color.Primary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.View)}")
                                    StartIcon="@Icons.Material.Filled.Preview"
                                    Size="Size.Small"
                                    OnClick="() => ViewDifficultyLevelDetailsAsync(difficultyLevel.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Edit">
                            <MudFab Color="Color.Secondary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Edit)}")
                                    EndIcon="@Icons.Material.Filled.Edit"
                                    Size="Size.Small"
                                    Disabled="@IsEditDisabled(difficultyLevel)"
                                    OnClick="() => UpdateDifficultyLevelAsync(difficultyLevel.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Delete">
                            <MudFab Color="Color.Error"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Delete)}")
                                    StartIcon="@Icons.Material.Filled.Delete"
                                    Size="Size.Small"
                                    Disabled="@IsDeleteDisabled(difficultyLevel)"
                                    OnClick="() => DeleteDifficultyLevelAsync(difficultyLevel.Id)" />
                        </MudTooltip>
                    </SettingToggle>
                }
            </ButtonChildContent>
        </ListItem>
    </MudCardContent>
</MudCard>