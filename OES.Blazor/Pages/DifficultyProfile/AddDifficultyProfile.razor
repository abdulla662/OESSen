@page "/AddDifficultyProfile"

@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute

@attribute [DynamicAuthorizeAttribute("AddDifficultyProfile")]

<PageTitle>@Resource.CreateDifficultyProfile</PageTitle>

<EditForm Model="@Model">
    <DataAnnotationsValidator />
    <MudCard Class="mx-auto mt-5 w-80 p-4 shadow-lg justify-content-center">
        <MudCardContent>
            <div class="d-flex justify-content-center align-items-center mb-6">
                <MudIcon Icon="@Icons.Material.Rounded.DriveFileRenameOutline" Color="Color.Primary" Class="me-2" Style="vertical-align: middle;" />
                <MudText Color="Color.Primary" Typo="Typo.h5" Style="line-height: 1;">
                    @Resource.CreateDifficultyProfile
                </MudText>
            </div>

            <div class="form-group">
                <MudTextField Label="@Resource.Name"
                              Required="true"
                              Immediate="true"
                              @bind-Value="Model.Name"
                              For="@(() => Model.Name)"
                              Class="mb-3"
                              Variant="Variant.Outlined" />
            </div>

            <div class="form-group">
                <MudTextField Label="@Resource.Description"
                              Required="true"
                              Immediate="true"
                              @bind-Value="Model.Description"
                              For="@(() => Model.Description)"
                              Class="mb-3"
                              Variant="Variant.Outlined" />
            </div>

            <MudCardActions Class="justify-content-center mt-2">
                <MudStack Row="true"
                          Spacing="4"
                          Class="w-50"
                          Justify="Justify.Center"
                          AlignItems="AlignItems.Center">
                    <GeneralLoadingButton ButtonText="@Resource.Save"
                                          Size="Size.Small"
                                          Class="flex-grow-1 p-2 rounded-pill"
                                          EndIcon="@Icons.Material.Filled.CheckCircle"
                                          Type="ButtonType.Submit"
                                          OnClick="OnValidSubmitAsync"
                                          Disabled="@(IsSubmitButtonDisabled)" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               Class="flex-grow-1 p-2 rounded-pill"
                               OnClick="Cancel"
                               EndIcon="@Icons.Material.Filled.Cancel">
                        @Resource.Cancel
                    </MudButton>
                </MudStack>
            </MudCardActions>
        </MudCardContent>
    </MudCard>
</EditForm>