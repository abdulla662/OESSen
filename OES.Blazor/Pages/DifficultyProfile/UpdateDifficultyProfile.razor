@page "/UpdateProfile"

@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute

@attribute [DynamicAuthorizeAttribute("UpdateDifficultyProfile")]

<PageTitle>@Resource.UpdateDifficultyProfile</PageTitle>

<EditForm Model="@model">
    <DataAnnotationsValidator />
    <MudCard Class="mx-auto mt-5 w-80 p-4 shadow-lg justify-content-center">
        <MudCardContent>
            <div class="d-flex justify-content-center align-items-center mb-6">
                <MudIcon Icon="@Icons.Material.Rounded.DriveFileRenameOutline" Color="Color.Primary" Class="me-2" Style="vertical-align: middle;" />
                <MudText Color="Color.Primary" Typo="Typo.h5" Style="line-height: 1;">
                    @Resource.UpdateDifficultyProfile
                </MudText>
            </div>

            <div class="form-group">
                <MudTextField Label="@Resource.Name"
                              Required="true"
                              Immediate="true"
                              @bind-Value="model.Name"
                              For="@(() => model.Name)"
                              Class="mb-3"
                              Variant="Variant.Outlined" />
            </div>

            <div class="form-group">
                <MudTextField Label="@Resource.Description"
                              Required="true"
                              Immediate="true"
                              @bind-Value="model.Description"
                              For="@(() => model.Description)"
                              Class="mb-3"
                              Variant="Variant.Outlined" />
            </div>

            <MudCardActions Class="justify-content-center w-100">
                <GeneralLoadingButton Disabled="@(IsSubmitButtonDisabled)"
                                      Class="w-100 m-3"
                                      OnClick="OnValidSubmitAsync"
                                      ButtonText="@Resource.Update"
                                      EndIcon="@Icons.Material.Filled.CheckCircle"
                                      Type="ButtonType.Submit" />
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Secondary" Class="w-100 m-3" OnClick="Cancel" EndIcon="@Icons.Material.Filled.Cancel">@Resource.Cancel</MudButton>
            </MudCardActions>
        </MudCardContent>
    </MudCard>
</EditForm>