@page "/UpdateEquationTemplate"

@using OES.Helper.Dtos.UserPapersDto
@using OES.Helper.Dtos.Paper.Responses
@using OES.Blazor.CustomAuthorizationAttribute
@using Helper.Enums
@using SharedHelper.Enums

@attribute [DynamicAuthorizeAttribute("UpdateEquationTemplate")]

<PageTitle>@Resource.UpdateEquationTemplate</PageTitle>

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 400px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <EditForm Model="@Model" OnSubmit="OnSubmit">
        <DataAnnotationsValidator />
        <MudCard Class="mt-4 mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
            <MudCardContent>
                <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-6">
                    <MudIcon Icon="@Icons.Material.Filled.Functions" Color="Color.Primary" Size="Size.Large" Class="me-2" />
                    <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.EditEquationTemplate</MudText>
                </MudStack>
                <MudPaper Elevation="0" Class="p-4 mb-3 mt-3 border rounded">
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <MudTextField Label="@Resource.Name"
                                          Variant="Variant.Outlined"
                                          Immediate
                                          Required
                                          Clearable
                                          Class="mb-3 w-100"
                                          T="string"
                                          @bind-Value="Model.Name"
                                          RequiredError="@Resource.NameIsRequired" />
                        </div>
                        <div class="col-12 col-md-6">
                            <MudTextField Label="@Resource.SelectPaper"
                                          Variant="Variant.Outlined"
                                          Class="mb-3 w-100"
                                          T="string"
                                          Value="@_paperName"
                                          Disabled="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock"
                                          AdornmentColor="Color.Secondary" />
                        </div>
                        <div class="col-12 col-md-6">
                            <MudTextField Label="@Resource.SelectForm"
                                          Variant="Variant.Outlined"
                                          Class="mb-3 w-100"
                                          T="string"
                                          Value="@_formName"
                                          Disabled="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock"
                                          AdornmentColor="Color.Secondary" />
                        </div>
                    </div>
                </MudPaper>

                <MudPaper Elevation="0" Class="p-4 mb-3 border rounded">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <MudText Typo="Typo.h6" Color="Color.Primary">@Resource.EquationCategories</MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenAddEquationDialog">
                            @Resource.AddCategory
                        </MudButton>
                    </div>

                    @if (_equations.Any())
                    {
                        <MudTable Items="_equations" Hover="true" Striped="true" Dense="true">
                            <HeaderContent>
                                <MudTh>@Resource.Name</MudTh>
                                <MudTh>@Resource.Equation</MudTh>
                                <MudTh>@Resource.ItemBanks</MudTh>
                                <MudTh>@Resource.Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="equation">
                                <MudTd DataLabel="@Resource.Name">@equation.Name</MudTd>
                                <MudTd DataLabel="@Resource.Equation">
                                    <code dir="auto" style="font-size: 0.85rem; unicode-bidi: plaintext;">@equation.DisplayEquation</code>
                                </MudTd>
                                <MudTd DataLabel="@Resource.ItemBanks">
                                    <MudChipSet T="string">
                                        @foreach (var itemBank in equation.SelectedItemBanks)
                                        {
                                            <MudChip Size="Size.Small" Color="Color.Info">@itemBank.Name</MudChip>
                                        }
                                    </MudChipSet>
                                </MudTd>
                                <MudTd DataLabel="@Resource.Actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Class=@($"label-{nameof(Resource.Edit)}")
                                                   OnClick="@(() => OpenEditEquationDialog(equation))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   Class=@($"label-{nameof(Resource.Delete)}")
                                                   OnClick="@(() => DeleteEquation(equation))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Start">@Resource.NoEquationCategoriesAdded</MudAlert>
                    }
                </MudPaper>

                @if (_paperType == PaperType.Standard)
                {
                    <MudPaper Elevation="0" Class="p-4 mb-3 border rounded">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <MudText Typo="Typo.h6" Color="Color.Primary">@Resource.TotalQuestionsEquation</MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@(string.IsNullOrWhiteSpace(_totalEquation) ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)"
                                       OnClick="OpenTotalEquationDialog">
                                @(string.IsNullOrWhiteSpace(_totalEquation) ? Resource.AddTotalEquation : Resource.EditTotalEquation)
                            </MudButton>
                        </div>

                        @* <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">@Resource.AvailableCategories</MudText>

                        <MudPaper Elevation="1" Class="pa-2 mb-3" Style="background-color: #e3f2fd;">
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var category in _equations)
                                {
                                    <MudChip T="string"
                                             Text="@category.Name"
                                             Color="Color.Primary"
                                             Variant="Variant.Filled"
                                             Size="Size.Small"
                                             OnClick="() => AddCategoryToTotalEquation(category.Name)"
                                             Style="cursor: pointer;" />
                                }
                            </div>
                        </MudPaper> *@

                        <MudTextField Value="@_totalEquationDisplay"
                                      Label="@Resource.TotalEquation"
                                      Variant="Variant.Outlined"
                                      Placeholder="@Resource.ExEquation"
                                      HelperText="@Resource.UseAvailableCategoriesAboveToCreateTotalEquation"
                                      Class="mb-3"
                                      ReadOnly="true" />

                        @if (!string.IsNullOrEmpty(_totalEquationError))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" ContentAlignment="HorizontalAlignment.Start">
                                @_totalEquationError
                            </MudAlert>
                        }

                        @if (!string.IsNullOrEmpty(_totalEquation) && string.IsNullOrEmpty(_totalEquationError))
                        {
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">
                                <strong>@Resource.ExpandedPreview:</strong>
                            </MudText>
                            <MudPaper Elevation="1" Class="pa-3" Style="background-color: #e8f5e9; border-radius: 4px;">
                                <div style="font-size: 0.87rem; font-family: monospace; word-break: break-all; font-weight: bold;">
                                    @((MarkupString)GetExpandedTotalEquation())
                                </div>
                            </MudPaper>
                        }
                    </MudPaper>
                }
                else if (_paperType == PaperType.Adaptive)
                {
                    <MudPaper Elevation="0" Class="p-4 mb-3 border rounded">
                        <MudPaper Elevation="1" Class="pa-3 mb-3" Style="background-color: #fff3e0; border-radius: 4px;">
                            <div style="flex: 1;">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-2">
                                    <strong>Final Score Equation:</strong>
                                </MudText>
                                <div style="font-size: 0.9rem; font-family: monospace; padding: 8px; background-color: #ffffff; border-radius: 4px; border: 1px solid #ffb74d;">
                                    <strong>Final Score (Type) = (Real (Type) D Score - (Type) Standard Deviation) / Standard Error<sub>2</sub> + Base Value<sub>2</sub></strong>
                                </div>
                            </div>
                        </MudPaper>

                        @if (_questionCategories != null && _questionCategories.Any())
                        {
                            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                                @foreach (var category in _questionCategories)
                                {
                                    <MudTabPanel Text="@category.Name" Icon="@Icons.Material.Filled.Category">
                                        <MudPaper Elevation="1" Class="pa-3">
                                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">@category.Name</MudText>
                                            <MudTextField T="string"
                                                          Class="mb-2"
                                                          Label="@($"Final score name - {category.Name}")"
                                                          Variant="Variant.Outlined"
                                                          Placeholder="Enter final score name"
                                                          Value="@_categoryFinalScoreNames.GetValueOrDefault(category.Id, string.Empty)"
                                                          ValueChanged="@((string value) => OnFinalScoreNameChanged(category.Id, value))" />
                                        </MudPaper>
                                    </MudTabPanel>
                                }
                            </MudTabs>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">@Resource.NoQuestionCategoriesAvailable</MudAlert>
                        }
                    </MudPaper>
                }
            </MudCardContent>
            <MudCardActions Class="justify-content-center mt-2">
                <MudStack Row="true"
                          Spacing="4"
                          Class="w-50"
                          Justify="Justify.Center"
                          AlignItems="AlignItems.Center">
                    <GeneralLoadingButton ButtonText="@Resource.Update"
                                          Size="Size.Small"
                                          Class="flex-grow-1 p-2 rounded-pill"
                                          EndIcon="@Icons.Material.Filled.CheckCircle"
                                          Type="ButtonType.Submit"
                                          Disabled="IsSubmitButtonDisabled" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               Class="flex-grow-1 p-2 rounded-pill"
                               OnClick="NavigateBack"
                               StartIcon="@Icons.Material.Filled.Cancel">
                        @Resource.Cancel
                    </MudButton>
                </MudStack>
            </MudCardActions>
        </MudCard>
    </EditForm>
}