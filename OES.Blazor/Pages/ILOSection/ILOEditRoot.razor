@page "/EditIloRoot"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.General

@attribute [DynamicAuthorizeAttribute("ILOEditRoot")]

<PageTitle>@Resource.UpdateILO</PageTitle>

<EditForm Model="@IloModel">
    <DataAnnotationsValidator />
    <MudCard Class="mx-auto mt-5 w-80 p-4 shadow-lg justify-content-center">
        <MudCardContent>
            <div class="d-flex align-items-center position-relative mt-4 mb-4">
                <div class="d-flex align-items-center mx-auto">
                    <MudIcon Icon="@Icons.Material.Outlined.Quiz" Color="Color.Primary" Class="me-2" Size="Size.Large" />
                    <MudText Color="Color.Primary" Typo="Typo.h5" Class="mb-0">
                        @Resource.UpdateILO @IloModel?.Name
                    </MudText>
                </div>
                <MudIconButton Class=@($"position-absolute end-0 label-{nameof(Resource.ManageGroups)}")
                               Icon="@Icons.Material.Filled.GroupAdd"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Medium"
                               OnClick="OpenGroupDialog" />
            </div>
            <div class="form-group">
                <MudTextField Label="@Resource.Name"
                              T="string"
                              Immediate
                              Required
                              Value="@IloModel.Name"
                              For="@(() => IloModel.Name)"
                              Class="mb-3"
                              Variant="Variant.Outlined"
                              ValueChanged="OnILONameChanged" />
            </div>
            <div class="form-group">
                <MudTextField Label="@Resource.Code"
                              Value="@IloModel.Code"
                              ValueChanged="@((string val) => IloModel.Code = ListHelpers.SanitizeCode(val))"
                              For="@(() => IloModel.Code)"
                              Immediate
                              Required
                              Class="mb-3"
                              Variant="Variant.Outlined" />
            </div>
            <div class="form-group">
                <MudTextField Label="@Resource.Description"
                              @bind-Value="IloModel.Description"
                              For="@(() => IloModel.Description)"
                              Immediate
                              Class="mb-3"
                              Variant="Variant.Outlined" />
            </div>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-content-center align-content-center gap-2 w-100">
            <GeneralLoadingButton Disabled="IsSubmitButtonDisabled"
                                  Class="flex-fill"
                                  OnClick="OnValidSubmitAsync"
                                  ButtonText="@Resource.Update"
                                  Type="ButtonType.Submit"
                                  EndIcon="@Icons.Material.Filled.CheckCircle" />
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Secondary" OnClick="Cancel" Class="flex-fill" EndIcon="@Icons.Material.Filled.Cancel"> @Resource.Cancel</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>