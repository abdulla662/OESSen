@page "/newILORoot"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.OESUserGroups
@using OES.Helper.General

@attribute [DynamicAuthorizeAttribute("NewRoot")]

<PageTitle>@Resource.RegisterNewILO</PageTitle>

<EditForm Model="@Model">
    <DataAnnotationsValidator />
    <MudCard Class="mx-auto mt-5 w-80 p-4 shadow-lg justify-content-center">
        <MudCardContent>
            <div class="d-flex justify-content-between align-items-center w-100 mt-3 mb-4">
                <div class="title-spacer"></div>
                <div class="d-flex align-items-center">
                    <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" Size="Size.Large" Class="me-2" />
                    <MudText Color="Color.Primary" Typo="Typo.h5" Class="mb-0 p-2">
                        @Resource.RegisterNewILO
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.GroupAdd"
                               Variant="@Variant.Filled"
                               Color="@Color.Primary"
                               Size="@Size.Large"
                               Class=@($"label-{nameof(Resource.ManageGroups)}")
                               OnClick="OpenGroupDialog" />
            </div>
            <div class="form-group">
                <MudTextField Label="@Resource.Name"
                              T="string"
                              Immediate
                              Required
                              Class="mb-3"
                              For="@(() => Model.Name)"
                              Variant="Variant.Outlined"
                              ValueChanged="OnILONameChanged" />
            </div>
            <div class="form-group">
                <MudTextField Label="@Resource.Code"
                              Value="@Model.Code"
                              ValueChanged="@((string val) => Model.Code = ListHelpers.SanitizeCode(val))"
                              Immediate
                              Required
                              Class="mb-3"
                              For="@(() => Model.Code)"
                              Variant="Variant.Outlined" />
            </div>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-content-center align-content-center gap-2 w-100">
            <GeneralLoadingButton Disabled="IsSubmitButtonDisabled"
                                  Class="flex-fill"
                                  OnClick="OnValidSubmitAsync"
                                  ButtonText="@Resource.Add"
                                  Type="ButtonType.Submit"
                                  EndIcon="@Icons.Material.Filled.CheckCircle" />
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Secondary" Class="flex-fill" OnClick="Cancel" EndIcon="@Icons.Material.Filled.Cancel">@Resource.Cancel</MudButton>
        </MudCardActions>
    </MudCard>
</EditForm>