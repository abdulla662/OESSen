@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.Components.GenericComponents.TreeViewTemplates.GrpcTreeViewTemplate
@using OES.Blazor.Pages.ILOTreeView.ILOInsertionDialogBox
@using OES.Helper.Dtos.ILO
@using OES.Helper.Dtos.TreeItem
@using OES.Helper.General

<MudDialog>
    <TitleContent>
        <div class="d-flex justify-content-between align-items-center w-100">
            <MudText Typo="Typo.h6"
                     Class="w-100"
                     Align="@(RightToLeft ? Align.Right : Align.Left)">
                @Resource.EditILO
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.GroupAdd"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Size="Size.Medium"
                           OnClick="OpenGroupDialog" />
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string"
                      Label="@Resource.Name"
                      @bind-Value="IloInsertionOrUpdateDialogParams.Name"
                      AutoFocus="true"
                      Clearable="true"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Class="mt-4"></MudTextField>

        <MudTextField T="string"
                      Label="@Resource.Code"
                      Value="@IloInsertionOrUpdateDialogParams.Code"
                      ValueChanged="@((string val) => IloInsertionOrUpdateDialogParams.Code = ListHelpers.SanitizeCode(val))"
                      AutoFocus="true"
                      Clearable="true"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Class="mt-4"></MudTextField>

        <MudTextField T="string"
                      Label="@Resource.Description"
                      @bind-Value="IloInsertionOrUpdateDialogParams.Description"
                      AutoFocus="true"
                      Clearable="true"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Class="mt-4"></MudTextField>

        <GrpcTreeViewTemplate LabelClass="mt-4 mb-1"
                              Label="@Resource.ParentNodewithNoteMessage"
                              Items="@Parents"
                              IsSingleSelectionTree="true"
                              GetSelectedTreeItem="GetSelectedTreeItem"
                              SelectedItemId="@Convert.ToInt64(IloInsertionOrUpdateDialogParams.ParentId)" />
    </DialogContent>
    <DialogActions>
        <div class="d-flex justify-content-center align-content-center gap-2 w-100 p-3">
            <GeneralLoadingButton Disabled="IsSubmitButtonDisabled"
                                  Class="flex-fill"
                                  OnClick="Submit"
                                  ButtonText="@Resource.Update"
                                  EndIcon="@Icons.Material.Filled.CheckCircle"
                                  Type="ButtonType.Submit" />
            <MudButton OnClick="Cancel"
                       Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="flex-fill"
                       EndIcon="@Icons.Material.Filled.Cancel">
                @Resource.Cancel
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
