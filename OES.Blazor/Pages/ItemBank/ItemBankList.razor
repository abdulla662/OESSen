@page "/ItemBankList"

@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.Components.Common;
@using OES.Blazor.Components.GenericComponents.SettingToggle
@using OES.Blazor.Services.Implementation.ItemBank
@using OES.Blazor.Services.Interfaces.ItemBank
@using OES.Helper
@using OES.Helper.Dtos.ItemBank.API
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.General

@attribute [DynamicAuthorizeAttribute("ItemBankList")]

<PageTitle>@Resource.ItemBanks</PageTitle>

<MudCard Class="mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.AccountBalance" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.ItemBanks</MudText>
        </MudStack>

        <ListItem @key="listItemReloadingKey"
                  T="NewItemBankDTO"
                  Caption="@Resource.ItemBanks"
                  CaptionIcon="@Icons.Material.Outlined.AccountBalance"
                  EndpointServerice="BlazItemBankService.GetAllItemBankAsync"
                  DisplayColumns='[ nameof(NewItemBankDTO.Code),
                                    nameof(NewItemBankDTO.Name),
                                    nameof(NewItemBankDTO.TotalQuestions),
                                    nameof(NewItemBankDTO.IsActive)]'
                  NoConvertColumns='[nameof(NewItemBankDTO.Code) ]'
                  AddNew_URL_OesRolesList="[OesTemplateRoleConstants.ItemBankCreator]"
                  AddNew_URL="/AddItemBank"
                  FirstSearchParameterLabel="@Resource.Code"
                  SecondSearchParameterLabel="@Resource.Name">
            <ButtonChildContent Context="value">
                @if (value is NewItemBankDTO itemBank)
                {
                    <SettingToggle OperationsText="@Resource.Operations">
                        <MudTooltip Text="@Resource.View">
                            <MudFab Color="Color.Primary"
                                    EndIcon="@Icons.Material.Filled.Preview"
                                    Size="Size.Small"
                                    Class=@($"fab-xsmall label-{nameof(Resource.View)}")
                                    OnClick='async () => await ViewItemBankAsync(itemBank.Id)' />
                        </MudTooltip>

                        <MudTooltip Text="@Resource.Edit">
                            <MudFab Color="Color.Secondary"
                                    EndIcon="@Icons.Material.Filled.Edit"
                                    Size="Size.Small"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Edit)}")
                                    OnClick='async () => await UpdateItemBankAsync(itemBank.Id)' />
                        </MudTooltip>

                        <MudTooltip Text="@Resource.Delete">
                            <MudFab Color="Color.Error"
                                    EndIcon="@Icons.Material.Filled.Delete"
                                    Size="Size.Small"
                                    class=@($"fab-xsmall label-{nameof(Resource.Delete)}")
                                    OnClick='async () => await RemoveRootItemBankAsync(itemBank.Id)' />
                        </MudTooltip>
                    </SettingToggle>
                }
            </ButtonChildContent>
        </ListItem>
    </MudCardContent>
</MudCard>