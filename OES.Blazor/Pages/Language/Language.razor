@page "/Language"

@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Blazor.Services.Interfaces.Language
@using OES.Helper.Dtos.Questionlanguage
@using OES.Helper.General
@using OES.Helper.General.ProtectedEntityHelper
@using OES.Blazor.Components.GenericComponents.SettingToggle

@attribute [DynamicAuthorizeAttribute("Language")]

<PageTitle>@Resource.SystemLanguages</PageTitle>

<MudCard Class="mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.Language" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.SystemLanguages</MudText>
        </MudStack>

        <ListItem @key=languagesListKey
                  T="LanguageDto"
                  Caption="@Resource.Language"
                  CaptionIcon="@Icons.Material.Rounded.Language"
                  EndpointServerice="BlazLanguageService.GetAllLanguages"
                  DisplayColumns='[nameof(LanguageDto.Name), nameof(LanguageDto.Direction)]'
                  AddNew_URL="/AddLanguage"
                  AddNew_URL_OesRolesList="[OesTemplateRoleConstants.DefinedLanguageCreator]"
                  HideCodeSearch="true"
                  SecondSearchParameterLabel="@Resource.Name">
            <ButtonChildContent Context="currentDtoContext">
                @if (currentDtoContext is LanguageDto language)
                {
                    <SettingToggle OperationsText="@Resource.Operations">
                        <MudTooltip Text="@Resource.Edit">
                            <MudFab Color="Color.Secondary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Edit)}")
                                    EndIcon="@Icons.Material.Filled.Edit"
                                    Size="Size.Small"
                                    Disabled="@(ProtectedEntityHelper.IsProtected(language.CreationUser, GlobalUserContext))"
                                    OnClick="() => UpdateLanguageAsync(language.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Delete">
                            <MudFab Color="Color.Error"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Delete)}")
                                    StartIcon="@Icons.Material.Filled.Delete"
                                    Size="Size.Small"
                                    Disabled="@(ProtectedEntityHelper.IsProtected(language.CreationUser, GlobalUserContext))"
                                    OnClick="() => DeleteLanguageAsync(language.Id)" />
                        </MudTooltip>
                    </SettingToggle>
                }
            </ButtonChildContent>
        </ListItem>
    </MudCardContent>
</MudCard>