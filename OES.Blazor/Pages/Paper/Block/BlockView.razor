@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Blazor.Pages.DeltaType
@using OES.Helper.Dtos.DifficultyProfile
@using System.Globalization
@using OES.Helper.Dtos.Question.QuestionDetailsDtos

@page "/BlockView"

@attribute [DynamicAuthorizeAttribute("BlockView")]

<PageTitle>@Resource.BlockDetails</PageTitle>

<MudCard Class="mx-auto mt-5 w-100 p-4 shadow-lg rounded">
    <MudCardContent>
        <div class="d-flex justify-content-center align-items-center mb-3">
            <MudIcon Icon="@Icons.Material.Filled.BorderAll" Color="Color.Primary" Class="me-2" Style="vertical-align: middle;" />
            <MudText Color="Color.Primary" Typo="Typo.h4" Style="line-height: 1;">@Resource.BlockDetails</MudText>
        </div>

        <MudGrid Spacing="3">

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3 shadow-sm d-flex align-items-center">
                    <MudText Color="Color.Secondary" Typo="Typo.subtitle1">📌 @Resource.BlockName </MudText>
                    <MudText Class="font-weight-bold ml-3">@block.Name</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3 shadow-sm d-flex align-items-center">
                    <MudText Color="Color.Secondary" Typo="Typo.subtitle1">📝 @Resource.Description </MudText>
                    <MudText Class="ml-3">@block.Description</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3 shadow-sm d-flex align-items-center">
                    <MudText Color="Color.Secondary" Typo="Typo.subtitle1">📦 @Resource.BlockCategory </MudText>
                    <MudText Class="font-weight-bold ml-3">@block.BlockTypeName</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3 shadow-sm d-flex align-items-center">
                    <MudText Color="Color.Secondary" Typo="Typo.subtitle1">⚙️ @Resource.DeltaType </MudText>
                    <MudText Class="font-weight-bold ml-3">@block.DeltaTypeName</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3 shadow-sm d-flex align-items-center">
                    <MudText Color="Color.Secondary" Typo="Typo.subtitle1">📊 @Resource.DifficultyLevel </MudText>
                    <MudText Class="font-weight-bold ml-3">@block.DifficultyLevelName</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudPaper Class="p-3 shadow-sm d-flex align-items-center">
                    <MudText Color="Color.Secondary" Typo="Typo.subtitle1">🔢 @Resource.QuestionCount</MudText>
                    <MudText Class="font-weight-bold ml-3">@numberOfQuestions</MudText>
                </MudPaper>
            </MudItem>

        </MudGrid>

        <MudDivider Class="mt-4 mb-4" />

        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-4">@Resource.AssociatedQuestions</MudText>

        @if (isBlockLoaded)
        {
            <ListItem T="BlockQuestionsDetailsPaginationDto"
                      Caption="@Resource.AssociatedQuestions"
                      CaptionIcon="@Icons.Material.Filled.BorderAll"
                      EndpointServerice="GetAllQuestions"
                      DisplayColumns='["Code", "Type", "ItemBank", "Body", "Language", "Subject", "Category", "DifficultyProfile", "DifficultyLevel"]'
                      Hide_DescriptionSearch="true"
                      SearchPanelVisible="false"
                      MultiSelection="false">
            </ListItem>
        }
    </MudCardContent>

    <MudCardActions Class="justify-content-center mt-4">
        <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Secondary" Class="w-50" OnClick="Close" EndIcon="@Icons.Material.Filled.Cancel">
             @Resource.Close
        </MudButton>
    </MudCardActions>
</MudCard>
