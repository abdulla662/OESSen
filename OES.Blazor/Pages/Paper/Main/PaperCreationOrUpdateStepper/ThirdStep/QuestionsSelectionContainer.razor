@using OES.Blazor.Pages.Paper.Main.PaperCreationOrUpdateStepper.ThirdStep.QuestionsSelection
@using OES.Helper.Enums
@using SharedHelper.Enums


@if (PaperMetadataResultedParamsDto.SelectedPaperType == PaperType.Standard)
{
    @if (PaperMetadataResultedParamsDto.SelectedQuestionSelectionType == QuestionSelectionType.Manual)
    {
        <ManualQuestionsSelection @ref="ManualQuestionsSelectionComponentRef" PaperMetadataResultedParamsDto="PaperMetadataResultedParamsDto" />
    }
    else if (PaperMetadataResultedParamsDto.SelectedQuestionSelectionType == QuestionSelectionType.Auto)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="my-4" Spacing="0">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2">
                <MudText Typo="Typo.h6" Color="Color.Default">
                    @Resource.AutomaticQuestionSelection
                </MudText>
                <MudIcon Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" Style="font-size: 1.6rem; vertical-align: middle;" Color="Color.Primary" />
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Style="font-size: 2.5rem;" Color="Color.Success" />
            </MudStack>
        </MudStack>
    }
}
else if (PaperMetadataResultedParamsDto.SelectedPaperType == PaperType.Adaptive)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="my-4" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Style="font-size: 2.5rem;" Color="Color.Success" />
        <MudText Align="Align.Center" Typo="Typo.subtitle1" Color="Color.Default">
            @Resource.BlockBasedQuestionSelection
        </MudText>
        <MudIcon Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" Style="font-size: 1.4rem; vertical-align: middle;" Color="Color.Primary" />
    </MudStack>
}