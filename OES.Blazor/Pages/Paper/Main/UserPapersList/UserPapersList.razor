@page "/UserPapers"

@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.Components.Common;
@using OES.Blazor.Components.GenericComponents.SettingToggle
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper
@using OES.Helper.Dtos.Question.QuestionDetailsDtos
@using OES.Helper.Dtos.UserPapersDto
@using OES.Helper.Enums
@using OES.Helper.General
@using SharedHelper.Enums

@attribute [DynamicAuthorizeAttribute("UserPapers")]

<PageTitle>@Resource.UserPapers</PageTitle>

<style>
    audio { display: none !important; }
    .mud-tooltip { white-space: normal !important; }
</style>

<MudCard Class="mt-4 mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.ListAlt" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Style="line-height: 1;" Color="Color.Primary">@Resource.UserPapers</MudText>
        </MudStack>

        <ListItem @key="listItemReloadingKey"
                  T="UserPapersListDto"
                  EndpointServerice="BlazPaperService.GetAllUserPapersAsync"
                  Caption="@Resource.ExamPaper"
                  CaptionIcon="@Icons.Material.Outlined.ListAlt"
                  ListTitle="@Resource.ExamPapers"
                  DisplayColumns="[ nameof(UserPapersListDto.Code),
                                    nameof(UserPapersListDto.Name),
                                    nameof(UserPapersListDto.TypeDisplay),
                                    nameof(UserPapersListDto.PaperStatusDisplay),
                                    nameof(UserPapersListDto.FormsStatusCountsSummary),
                                    nameof(UserPapersListDto.SubTypeDisplay),
                                    nameof(UserPapersListDto.PaperCreationStatusDisplay) ]"
                  NoConvertColumns='[nameof(UserPapersListDto.Code)]'
                  Create_Btn="true"
                  FirstSearchParameterLabel="@Resource.Code"
                  SecondSearchParameterLabel="@Resource.Name"
                  CreateClick_fun="AddPaperAsync"
                  CreateClick_fun_OesRolesList="[OesTemplateRoleConstants.PaperCreator]"
                  FilterObject="PaperFilterPaginationModel">
            <TopChildContent>
                <MudCard Class="mb-3">
                    <MudCardContent>
                        <MudGrid Justify="Justify.Center">
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete T="string" Label="@Resource.SelectPaperType" Clearable="true" @bind-Value="SelectedPaperType" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" SearchFunc="SearchPaperTypes" ToStringFunc="@(x => x?.ToLocalizedString<PaperType>())" CoerceValue="true" ResetValueOnEmptyText="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete T="string" Label="@Resource.QuestionSelectionType" Clearable="true" @bind-Value="SelectedQuestionSelectionType" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" SearchFunc="SearchQuestionSelectionTypes" ToStringFunc="@(x => x?.ToLocalizedString<QuestionSelectionType>())" CoerceValue="true" ResetValueOnEmptyText="true" Disabled="@IsQuestionSelectionDisabled" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete T="string" Label="@Resource.SelectPaperCreationStatus" Clearable="true" @bind-Value="SelectedPaperCreationStatus" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" SearchFunc="SearchPaperCreationStatuses" ToStringFunc="@(x => x?.ToLocalizedString<PaperCreationStatus>())" CoerceValue="true" ResetValueOnEmptyText="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete T="PaperStatus" Label="@Resource.SelectCompletionStatus" Clearable="true" @bind-Value="SelectedStatusFilter" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" SearchFunc="SearchCompletionStatuses" ToStringFunc="@(x => x.ToLocalizedString())" CoerceValue="true" ResetValueOnEmptyText="true" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>
            </TopChildContent>
            <ButtonChildContent Context="value">
                @if (value is UserPapersListDto paper)
                {
                    <SettingToggle OperationsText="@Resource.Operations">
                        @if (paper.Type != PaperType.Adaptive)
                        {
                            <MudTooltip Text="@Resource.ViewFormsDetails">
                                <MudFab Color="Color.Primary"
                                        StartIcon="@Icons.Material.Filled.DynamicForm"
                                        Size="Size.Small"
                                        Class=@($"fab-xsmall label-{nameof(Resource.ViewFormsDetails)}")
                                        OnClick='() => ViewPaginatedFormsAsync(paper)' />
                            </MudTooltip>

                            <MudTooltip Text="@Resource.ManageGroups">
                                <MudFab Color="Color.Primary"
                                        StartIcon="@Icons.Material.Filled.GroupAdd"
                                        Size="Size.Small"
                                        Class=@($"fab-xsmall label-{nameof(Resource.ManageGroups)}")
                                        OnClick='() => OpenPaperGroupDialogAsync(paper)'
                                        Disabled="@(!CanEditGroupsForPaper(paper))" />
                            </MudTooltip>

                            <MudTooltip Text="@Resource.ViewForms">
                                <MudFab Color="Color.Info"
                                        StartIcon="@Icons.Material.Filled.Article"
                                        Size="Size.Small"
                                        Class=@($"fab-xsmall label-{nameof(Resource.ViewForms)}")
                                        OnClick='() => ViewPaperFormsAsync(paper)' />
                            </MudTooltip>

                            <MudTooltip Text="@Resource.ResetPaperFormsCounter">
                                <MudFab Color="Color.Warning"
                                        EndIcon="@Icons.Material.Filled.RestartAlt"
                                        Size="Size.Small"
                                        Class=@($"fab-xsmall label-{nameof(Resource.ResetPaperFormsCounter)}")
                                        OnClick='() => ResetPaperFormsCounterAsync(paper)'
                                        Disabled="@(!CanResetPaper(paper))" />
                            </MudTooltip>

                            <MudTooltip Text="@Resource.ContinuePendingForm">
                                <MudFab Color="Color.Success"
                                        EndIcon="@Icons.Material.Filled.PlayArrow"
                                        Size="Size.Small"
                                        Class=@($"fab-xsmall label-{nameof(Resource.ContinuePendingForm)}")
                                        OnClick='() => ContinuePendingPaperFormAsync(paper)'
                                        Disabled="@(!CanContinuePaper(paper))" />
                            </MudTooltip>
                        }

                        <MudTooltip Text="@Resource.CopyIt">
                            <MudFab Color="Color.Default"
                                    StartIcon="@Icons.Material.Filled.ContentCopy"
                                    Size="Size.Small"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Copy)}")
                                    OnClick='() => OpenCopyPaperDeeplyDialogAsync(paper)' />
                        </MudTooltip>

                        @if (paper.Type == PaperType.Adaptive)
                        {
                            <MudTooltip Text="@Resource.Edit">
                                <MudFab Color="Color.Secondary"
                                        EndIcon="@Icons.Material.Filled.Edit"
                                        Size="Size.Small"
                                        Class=@($"fab-xsmall label-{nameof(Resource.Edit)}")
                                        OnClick='() => EditSuspendedPaperAsync(paper)' />
                            </MudTooltip>
                        }

                        <MudTooltip Text="@(Resource.ManageSuspensions)">
                            <MudFab Color="Color.Warning"
                                    EndIcon="@Icons.Material.Filled.ToggleOn"
                                    Size="Size.Small"
                                    Class=@($"fab-xsmall label-{nameof(Resource.ManageSuspensions)}")
                                    OnClick='() => OpenSuspendPaperDialogAsync(paper)'
                                    Disabled ="@(paper.PaperStatus != AvailabilityStatus.Synced && paper.PaperStatus != AvailabilityStatus.Suspended)" />
                        </MudTooltip>

                        <MudTooltip Text="@Resource.Delete">
                            <MudFab Color="Color.Error"
                                    StartIcon="@Icons.Material.Filled.Delete"
                                    Size="Size.Small"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Delete)}")
                                    OnClick='() => DeletePaperAsync(paper.Id)' />
                        </MudTooltip>
                    </SettingToggle>
                }
            </ButtonChildContent>
        </ListItem>
    </MudCardContent>
</MudCard>