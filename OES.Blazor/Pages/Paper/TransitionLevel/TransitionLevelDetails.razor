@page "/TransitionLevelDetails"

@attribute [DynamicAuthorizeAttribute("TransitionLevelDetails")]

@using OES.Blazor.CustomAuthorizationAttribute

<PageTitle>@Resource.TransitionLevelDetails</PageTitle>

<div class="d-flex justify-content-center align-items-center">
    <MudCard Class="mx-auto mt-5 w-75 p-4 shadow-lg justify-content-center">
        <MudCardContent>
            <div class="d-flex justify-content-center align-items-center">
                <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Class="mr-2" />
                <MudText Color="Color.Primary" Typo="Typo.h5" Class="justify-content-center mb-5 p-2">@Resource.DifficultyLevel</MudText>
            </div>

            <div class="row mt-3">
                <div class="col-sm-3">
                    <MudText Color="Color.Primary" Class="mb-0">@Resource.Name</MudText>
                </div>
                <MudText Class="col-sm-9">@model.Name</MudText>
            </div>

            <div class="row mt-3">
                <div class="col-sm-3">
                    <MudText Color="Color.Primary" Class="mb-0">@Resource.LowerDScoreFormatted</MudText>
                </div>
                <MudText Class="col-sm-9">@model.LowerDScoreFormatted</MudText>
            </div>

            <div class="row mt-3">
                <div class="col-sm-3">
                    <MudText Color="Color.Primary" Class="mb-0">@Resource.UpperDScoreFormatted</MudText>
                </div>
                <MudText Class="col-sm-9">@model.UpperDScoreFormatted</MudText>
            </div>

            <div class="row mt-3">
                <div class="col-sm-3">
                    <MudText Color="Color.Primary" Class="mb-0">@Resource.DifficultyProfileName</MudText>
                </div>
                <MudText Class="col-sm-9">@model.TransitionProfileName</MudText>
            </div>

            <div class="row mt-3">
                <div class="col-sm-3">
                    <MudText Color="Color.Primary" Class="mb-0">@Resource.DifficultyProfileDescrption</MudText>
                </div>
                <MudText Class="col-sm-9">@model.TransitionProfileDescription</MudText>
            </div>
        </MudCardContent>

        <MudCardActions Class="justify-content-center mt-3">
            <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" Color="Color.Secondary" Class="w-100" OnClick="Close" EndIcon="@Icons.Material.Filled.Cancel">@Resource.Close</MudButton>
        </MudCardActions>
    </MudCard>
</div>

