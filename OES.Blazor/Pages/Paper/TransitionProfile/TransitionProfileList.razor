@page "/TransitionProfiles"

@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.Paper
@using OES.Helper.Dtos.TransitionProfile
@using OES.Blazor.Components.GenericComponents.SettingToggle
@using OES.Helper.General

@attribute [DynamicAuthorizeAttribute("TransitionProfileList")]

<PageTitle>@Resource.TransitionProfiles</PageTitle>

<MudCard Class="mt-4 mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.DirectionsTransit" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.TransitionProfiles</MudText>
        </MudStack>
        <ListItem @key=_transactionKey
                  T="TransitionProfileDto"
                  EndpointServerice="BlazTransitionProfile.GetAllTransitionProfile"
                  Caption=@Resource.TransitionProfile
                  CaptionIcon="@Icons.Material.Filled.DirectionsTransit"
                  DisplayColumns='["Name"]'
                  AddNew_URL="/AddTransitionProfile"
                  AddNew_URL_OesRolesList="[OesTemplateRoleConstants.TransitionProfileCreate]"
                  HideCodeSearch="true"
                  SecondSearchParameterLabel="@Resource.Name">
            <ButtonChildContent Context="value">
                @if (value is TransitionProfileDto profile)
                {
                    <SettingToggle OperationsText="@Resource.Operations">
                        <MudTooltip Text="@Resource.View">
                            <MudFab Color="Color.Primary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.View)}")
                                    StartIcon="@Icons.Material.Filled.Preview"
                                    Size="Size.Small"
                                    OnClick="() => ViewTransitionProfileAsync(profile.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Edit">
                            <MudFab Color="Color.Secondary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Edit)}")
                                    EndIcon="@Icons.Material.Filled.Edit"
                                    Size="Size.Small"
                                    OnClick="() => NavigateToEditAsync(profile.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Delete">
                            <MudFab Color="Color.Error"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Delete)}")
                                    StartIcon="@Icons.Material.Filled.Delete"
                                    Size="Size.Small"
                                    OnClick="() => DeleteTransitionAsync(profile.Id)" />
                        </MudTooltip>
                    </SettingToggle>
                }
            </ButtonChildContent>
        </ListItem>
    </MudCardContent>
</MudCard>