@* @page "/AssignRoleToPath" *@

@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.PagesEndpointsRolesDtos

@attribute [DynamicAuthorizeAttribute("AssignRoleToPath")]

<PageTitle>@Resource.AssignRolesToPath</PageTitle>

<MudCard Class="mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-6">
            <MudIcon Icon="@Icons.Material.Rounded.AssignmentReturned" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.AssignRolesToPath</MudText>
        </MudStack>
        <MudItem xs="12" Class="mb-3">
            <MudAutocomplete T="BlazPathDTO"
                             @key="Paths"
                             Label="@Resource.SelectPath"
                             Value="SelectedPath"
                             Variant="Variant.Outlined"
                             ValueChanged="GetPathRolesAsync"
                             SearchFunc="@SearchPathsAsync"
                             ToStringFunc="@(e => e == null ? null : $"{e.Name}")"
                             ResetValueOnEmptyText="true"
                             CoerceText="true"
                             CoerceValue="false"
                             Immediate="true"
                             Required="true"
                             RequiredError="@Resource.Pathisrequiredhere"
                             Clearable="true" />
        </MudItem>
        <MudItem xs="12" Class="mb-3">
            <MudSelect T="RoleDto"
                       Label="@Resource.SelectRole"
                       MultiSelection="true"
                       @bind-SelectedValues="CurrentRoles"
                       ToStringFunc="@(org => org == null ? null : $"{org.Name}")"
                       Variant="Variant.Outlined"
                       Immediate="true"
                       Required="true"
                       RequiredError="@Resource.Selectatleastonerole"
                       SelectAll="true"
                       SelectAllText="@Resource.SelectallRoles"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var role in Roles)
                {
                    <MudSelectItem T="RoleDto" Value="@role">@role.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" Class="ms-1">
            @if (CurrentRoles.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">@Resource.SelectedRoles</MudText>
                @foreach (var role in CurrentRoles)
                {
                    <MudChip T="RoleDto" Color="Color.Primary">@role.Name</MudChip>
                }
            }
        </MudItem>
    </MudCardContent>
    <MudCardActions Class="justify-content-between mb-5">
        <GeneralLoadingButton Disabled="@(!CurrentRoles.Any() || SelectedPath == null)"
                              Class="flex-fill"
                              OnClick="OnSubmit"
                              EndIcon="@Icons.Material.Filled.CheckCircle"
                              ButtonColor="Color.Primary"
                              ButtonText="@Resource.Assign"
                              Type="ButtonType.Button" />
    </MudCardActions>
</MudCard>