@page "/AddQualityCheckCommittee"

@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.ItemBank

@attribute [DynamicAuthorizeAttribute("AddQualityCheckCommittee")]

<PageTitle>@Resource.AddNewQuestionsQualityCheckCommittee</PageTitle>

<EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <MudCard Class="mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
        <MudCardContent>
            <div class="form-group d-flex justify-content-center align-items-center">
                <MudIcon Icon="@Icons.Material.Rounded.People" Color="Color.Primary" Size="Size.Large" Class="me-2" />
                <MudText Typo="Typo.h4" Align="Align.Left" Color="Color.Primary">
                    @Resource.AddNewQuestionsQualityCheckCommittee
                </MudText>
            </div>

            <!-- Committee Name -->
            <div class="form-group d-flex justify-content-center">
                <MudTextField Label="@Resource.Name"
                              Variant="Variant.Outlined"
                              Immediate
                              Required="true"
                              For="@(() => Model.Name)"
                              @bind-Value="Model.Name" />
            </div>
            
            <!-- Committee Description -->
            <div class="form-group d-flex justify-content-center">
                <MudTextField Label="@Resource.Description"
                              Variant="Variant.Outlined"
                              Immediate
                              Required="true"
                              For="@(() => Model.Description)"
                              @bind-Value="Model.Description" />
            </div>

            <!-- Chief Selector -->
            <MudPaper Elevation="0" Class="pa-4 rounded-lg border-dashed-primary mt-3">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="fw-600">
                            @Resource.SelectChief
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="OpenChiefSelectionDialog">
                        @Resource.SelectChief
                    </MudButton>
                </MudStack>

                @if (Model.ChiefUserId != Guid.Empty)
                {
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                        <MudChip T="string"
                                 Color="Color.Primary"
                                 Variant="Variant.Outlined"
                                 Size="Size.Small"
                                 Icon="@Icons.Material.Filled.Verified">
                            @Users.FirstOrDefault(u => u.ID == Model.ChiefUserId)?.Name
                        </MudChip>
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        @Resource.ChiefIsRequiredToCreateCommittee
                    </MudText>
                }
            </MudPaper>

            <!-- Members Selector -->
            <MudPaper Elevation="0" Class="pa-4 rounded-lg border-dashed-primary mt-3">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="fw-600">
                            @Resource.SelectMembers
                        </MudText>
                        @if (Model.MemberUserIds.Count > 0)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                                @Model.MemberUserIds.Count
                            </MudChip>
                        }
                    </MudStack>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="OpenMemberSelectionDialog">
                        @Resource.SelectMembers
                    </MudButton>
                </MudStack>

                @if (Model.MemberUserIds.Count > 0)
                {
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var memberId in Model.MemberUserIds)
                        {
                            var user = Users.FirstOrDefault(u => u.ID == memberId);
                            if (user == null) continue;

                            @if (memberId == Model.ChiefUserId)
                            {
                                <MudChip T="string"
                                         Color="Color.Primary"
                                         Variant="Variant.Outlined"
                                         Size="Size.Small"
                                         Icon="@Icons.Material.Filled.Verified">
                                    @user.Name
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string"
                                         Color="Color.Default"
                                         Variant="Variant.Outlined"
                                         Size="Size.Small"
                                         Icon="@Icons.Material.Filled.Person"
                                         OnClose="@(() => RemoveMember(memberId))">
                                    @user.Name
                                </MudChip>
                            }
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        @Resource.YouHaveToSelectAtLeastOneMember
                    </MudText>
                }
            </MudPaper>

            <div class="form-group d-flex flex-column align-items-center justify-content-center mt-4">
                <div class="d-flex flex-row w-100 justify-content-center">
                    <MudAutocomplete T="RootItemBankDto"
                                     Label="@Resource.SelectRootItemBank"
                                     @bind-Value="SelectedRootItemBankForMultiSelect"
                                     @bind-Value:after="OnRootItemBankChanged"
                                     SearchFunc="SearchItemBankRootsAsync"
                                     ToStringFunc="ItemBankDtoToStringConverter"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Class="flex-grow-1" />
                    <MudFab Label="@Resource.ShowTree"
                            Class="ms-2 align-self-center"
                            OnClick="OpenMultiSelectItemBankDialogAsync"
                            EndIcon="@Icons.Material.Filled.AccountTree"
                            Disabled="SelectedRootItemBankForMultiSelect == null" />
                </div>

                <div class="mt-3 w-100">
                    <MudPaper Class="pa-2" Elevation="0" Style="min-height: 50px;">
                        @if (SelectedItemBanks.Any()) 
                        {
                            <MudChipSet T="long" AllClosable="true" OnClose="@((chip) => RemoveSelectedItemBank(chip.Value))">
                                @foreach (var item in SelectedItemBanks)
                                {
                                    <MudChip Value="item.Id">@item.Text</MudChip>
                                }
                            </MudChipSet>
                        }

                        @if (SelectedRootItemBankForMultiSelect != null && !SelectedItemBanks.Any())
                        {
                            <MudAlert Severity="Severity.Error"
                                      ContentAlignment="HorizontalAlignment.Start"
                                      Class="w-100 mt-3">
                                @Resource.SelectNodeBeforeProceeding
                            </MudAlert>
                        }
                    </MudPaper>
                </div>
            </div>
        </MudCardContent>

        <MudCardActions Class="justify-content-center mt-2">
            <MudStack Row="true"
                      Spacing="4"
                      Class="w-50"
                      Justify="Justify.Center"
                      AlignItems="AlignItems.Center">
                <GeneralLoadingButton ButtonText="@Resource.Add"
                                      Size="Size.Small"
                                      Class="flex-grow-1 p-2 rounded-pill"
                                      EndIcon="@Icons.Material.Filled.CheckCircle"
                                      Type="ButtonType.Submit"
                                      OnClick="HandleValidSubmit"
                                      Disabled="IsFormInvalidOrSubmitting" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           Class="flex-grow-1 p-2 rounded-pill"
                           OnClick="NavigateBack"
                           EndIcon="@Icons.Material.Filled.Cancel">
                    @Resource.Cancel
                </MudButton>
            </MudStack>
        </MudCardActions>
    </MudCard>
</EditForm>