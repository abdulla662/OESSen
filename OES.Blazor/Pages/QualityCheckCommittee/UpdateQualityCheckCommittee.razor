@page "/UpdateQualityCheckCommittee"

@using OES.Helper.Dtos.QualityCheckCommittee
@using OES.Helper.Dtos.User
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.ItemBank

@attribute [DynamicAuthorizeAttribute("UpdateQualityCheckCommittee")]

<PageTitle>@Resource.UpdateQuestionsQualityCheckCommittee</PageTitle>

<EditForm Model="@Model" OnValidSubmit="OnValidSubmitAsync">
    <DataAnnotationsValidator />
    <MudCard Class="mx-auto w-80 mt-5 p-4 shadow-lg justify-content-center">
        <MudCardContent>
            <!-- Title -->
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-6">
                <MudIcon Icon="@Icons.Material.Rounded.Checklist" Color="Color.Primary" Size="Size.Large" Class="me-2" />
                <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.UpdateQuestionsQualityCheckCommittee</MudText>
            </MudStack>

            <!-- Committee Name -->
            <div class="form-group">
                <MudTextField @bind-Value="Model.Name"
                              Label="@Resource.Name"
                              Variant="Variant.Outlined"
                              Immediate
                              Required="true"
                              For="@(() => Model.Name)" />
            </div>

            <!-- Committee Description -->
            <div class="form-group mt-4">
                <MudTextField @bind-Value="Model.Description"
                              Label="@Resource.Description"
                              Variant="Variant.Outlined"
                              Immediate />
            </div>

            <!-- Chief Selector -->
            <MudPaper Elevation="0" Class="pa-4 rounded-lg border-dashed-primary mt-3">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="fw-600">
                            @Resource.SelectChief
                        </MudText>
                    </MudStack>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="OpenChiefSelectionDialog">
                        @Resource.SelectChief
                    </MudButton>
                </MudStack>

                @if (Model.ChiefId != Guid.Empty)
                {
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                        <MudChip T="string"
                                 Color="Color.Primary"
                                 Variant="Variant.Outlined"
                                 Size="Size.Small"
                                 Icon="@Icons.Material.Filled.Verified">
                            @Users.FirstOrDefault(u => u.ID == Model.ChiefId)?.Name
                        </MudChip>
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        @Resource.ChiefIsRequiredToCreateCommittee
                    </MudText>
                }
            </MudPaper>

            <!-- Members Selector -->
            <MudPaper Elevation="0" Class="pa-4 rounded-lg border-dashed-primary mt-3">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="fw-600">
                            @Resource.SelectMembers
                        </MudText>
                        @if (_selectedMemberIds.Count > 0)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                                @_selectedMemberIds.Count
                            </MudChip>
                        }
                    </MudStack>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="OpenMemberSelectionDialog">
                        @Resource.SelectMembers
                    </MudButton>
                </MudStack>

                @if (_selectedMemberIds.Count > 0)
                {
                    <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var memberId in _selectedMemberIds)
                        {
                            var user = Users.FirstOrDefault(u => u.ID == memberId);
                            if (user == null) continue;

                            @if (memberId == Model.ChiefId)
                            {
                                <MudChip T="string"
                                         Color="Color.Primary"
                                         Variant="Variant.Outlined"
                                         Size="Size.Small"
                                         Icon="@Icons.Material.Filled.Verified">
                                    @user.Name
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string"
                                         Color="Color.Default"
                                         Variant="Variant.Outlined"
                                         Size="Size.Small"
                                         Icon="@Icons.Material.Filled.Person"
                                         OnClose="@(() => RemoveMember(memberId))">
                                    @user.Name
                                </MudChip>
                            }
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        @Resource.YouHaveToSelectAtLeastOneMember
                    </MudText>
                }
            </MudPaper>

            <!-- Item Bank Multi-Selector -->
            <div class="form-group d-flex flex-column align-items-center justify-content-center mt-4">
                <div class="d-flex flex-row w-100 justify-content-center">
                    <MudAutocomplete T="RootItemBankDto"
                                     Label="@Resource.SelectRootItemBank"
                                     @bind-Value="_selectedRootItemBankForMultiSelect"
                                     @bind-Value:after="OnRootItemBankChanged"
                                     SearchFunc="SearchItemBankRootsAsync"
                                     ToStringFunc="ItemBankDtoToStringConverter"
                                     Variant="Variant.Outlined"
                                     Clearable="true"
                                     Class="flex-grow-1" />
                    <MudFab Label="@Resource.ShowTree"
                            Class="ms-2 align-self-center"
                            OnClick="OpenMultiSelectItemBankDialogAsync"
                            EndIcon="@Icons.Material.Filled.AccountTree"
                            Disabled="_selectedRootItemBankForMultiSelect == null" />
                </div>

                <div class="mt-3 w-100">
                    <MudPaper Class="pa-2" Elevation="0" Style="min-height: 50px;">
                        @if (_selectedItemBanks.Any())
                        {
                            <MudChipSet T="long" AllClosable="true" OnClose="@((chip) => RemoveSelectedItemBank(chip.Value))">
                                @foreach (var item in _selectedItemBanks)
                                {
                                    <MudChip Value="item.Id">@item.Name</MudChip>
                                }
                            </MudChipSet>
                        }

                        @if (_selectedRootItemBankForMultiSelect != null && !_selectedItemBanks.Any())
                        {
                            <MudAlert Severity="Severity.Error"
                                      ContentAlignment="HorizontalAlignment.Start"
                                      Class="w-100 mt-3">
                                @Resource.SelectNodeBeforeProceeding
                            </MudAlert>
                        }
                    </MudPaper>
                </div>
            </div>

            <!-- Members Table -->
            <MudTable Items="Model.Members" Elevation="0" Dense="true" Bordered="true" Hover="true" Class="mt-4">
                <HeaderContent>
                    <MudTh>@Resource.UserName</MudTh>
                    <MudTh>@Resource.Email</MudTh>
                    <MudTh>@Resource.Roles</MudTh>
                    <MudTh>@Resource.Active</MudTh>
                </HeaderContent>
                <RowTemplate Context="member">
                    <MudTd DataLabel="@Resource.UserName">@member.Username</MudTd>
                    <MudTd DataLabel="@Resource.Email">@member.Email</MudTd>
                    <MudTd DataLabel="@Resource.Roles">
                        @if (member.UserId == Model.ChiefId)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text">@Resource.ChiefAndMember</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Text">@Resource.Member</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="@Resource.IsActive">
                        <MudSwitch @bind-Value="member.IsActive" Color="Color.Primary" UncheckedColor="Color.Secondary" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudCardContent>

        <MudCardActions Class="justify-content-center mt-2">
            <MudStack Row="true"
                      Spacing="4"
                      Class="w-50"
                      Justify="Justify.Center"
                      AlignItems="AlignItems.Center">
                <GeneralLoadingButton ButtonText="@Resource.Update"
                                      Class="flex-grow-1 p-2 rounded-pill"
                                      Size="Size.Small"
                                      EndIcon="@Icons.Material.Filled.CheckCircle"
                                      Type="ButtonType.Submit"
                                      OnClick="OnValidSubmitAsync"
                                      Disabled="IsSubmitButtonDisabled" />
                                       
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           Class="flex-grow-1 p-2 rounded-pill"
                           OnClick="Cancel"
                           EndIcon="@Icons.Material.Filled.Cancel">
                    @Resource.Cancel
                </MudButton>
            </MudStack>
        </MudCardActions>
    </MudCard>
</EditForm>
