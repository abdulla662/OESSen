@using OES.Helper.Dtos.Questionlanguage
@using OES.Helper.ResourceFiles

<MudPaper Class="pa-4 mb-4" Elevation="3">
    <div class="d-flex flex-column gap-3 mb-4">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Rounded.Quiz" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h6" Color="Color.Primary">@Resource.SegmentQuestions</MudText>
        </div>
        <div class="d-flex justify-end">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudSelect T="LanguageDto"
                           Value="SelectedLanguage"
                           ValueChanged="@OnLanguageChanged"
                           Variant="Variant.Outlined"
                           ToStringFunc="(l => l?.Name)"
                           Label="@Resource.SelectLanguage"
                           Required
                           Dense="true"
                           Style="min-width: 200px; max-width: 250px;"
                           AnchorOrigin="Origin.BottomCenter"
                           Disabled="@Segments.Any()">
                    @foreach (var language in Languages)
                    {
                        <MudSelectItem Value="language" />
                    }
                </MudSelect>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@OnCreateSegmentClicked"
                           Disabled="@(SelectedLanguage == null || SelectedLanguage.Id == 0)">
                    @Resource.AddSegment
                </MudButton>
            </MudStack>
        </div>
    </div>

    @if (Segments.Count == 0)
    {
        <MudPaper Class="pa-8" Outlined="true" Style="border-style: dashed;">
            <div class="d-flex flex-column align-center justify-center" style="min-height: 200px;">
                <MudIcon Icon="@Icons.Material.Outlined.PlaylistAdd" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                    @Resource.NoSegmentQuestionsAdded
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-2">
                    @Resource.ClickAddButtonToCreateYourFirstSegment
                </MudText>
            </div>
        </MudPaper>
    }
    else
    {
        @for (int i = 0; i < Segments.Count; i++)
        {
            var index = i;
            var question = Segments[i];

            <MudPaper Class="pa-4 mb-3 segment-card" Elevation="2">
                <div class="d-flex align-center gap-3">
                    <div class="d-flex flex-column gap-1">
                        @if (index > 0)
                        {
                            <MudIconButton Icon="@Icons.Material.Rounded.KeyboardArrowUp"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           Class=@($"pa-1 label-{nameof(Resource.MoveUp)}")
                                           OnClick="@(() => OnMoveUp(index))" />
                        }
                        @if (index < Segments.Count - 1)
                        {
                            <MudIconButton Icon="@Icons.Material.Rounded.KeyboardArrowDown"
                                           Color="Color.Primary"
                                           Size="Size.Large"
                                           Class=@($"pa-1 label-{nameof(Resource.MoveDown)}")
                                           OnClick="@(() => OnMoveDown(index))" />
                        }
                    </div>

                    <MudChip T="int"
                             Color="Color.Primary"
                             Size="Size.Medium">
                        #@(index + 1)
                    </MudChip>

                    <div class="flex-grow-1 mw-100 overflow-y-auto">
                        <MudText Typo="Typo.body2"
                                 Color="Color.Secondary"
                                 Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @((MarkupString)(string.IsNullOrWhiteSpace(question.SegmentQuestionDetailsDto?.Body) ? Resource.NoBodyProvided : question.SegmentQuestionDetailsDto.Body))
                        </MudText>
                    </div>

                    <div class="d-flex gap-2">
                        <MudTooltip Text="@Resource.Edit">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Secondary"
                                           Size="Size.Medium"
                                           Class=@($"label-{nameof(Resource.Edit)}")
                                           OnClick="@(() => OnEditSegment(question))" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Medium"
                                           Class=@($"label-{nameof(Resource.Delete)}")
                                           OnClick="@(() => OnDeleteSegment(question))" />
                        </MudTooltip>
                    </div>
                </div>
            </MudPaper>
        }

        <MudAlert Severity="Severity.Info"
                  Class="mt-4"
                  Variant="Variant.Outlined"
                  ContentAlignment="HorizontalAlignment.Start">
            <MudText Typo="Typo.body2">
                @Resource.Total: @Segments.Count
            </MudText>
        </MudAlert>
    }
</MudPaper>