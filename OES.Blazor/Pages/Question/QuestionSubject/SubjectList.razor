@page "/SubjectList"

@using OES.Helper.Dtos.QuestionCategory
@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.Subject
@using OES.Helper.General
@using OES.Helper.General.ProtectedEntityHelper
@using OES.Blazor.Components.GenericComponents.SettingToggle

@attribute [DynamicAuthorizeAttribute("SubjectList")]

<PageTitle>@Resource.SystemSubjects</PageTitle>

<MudCard Class="mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.Subject" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.SystemSubjects</MudText>
        </MudStack>

        <ListItem T="SubjectDto"
                  Caption="@Resource.QuestionSubject"
                  CaptionIcon="@Icons.Material.Filled.Subject"
                  @key="subjectsListKey"
                  EndpointServerice="BlazSubjectService.GetAllSubjectPaginationAsync"
                  DisplayColumns='["Name"]'
                  AddNew_URL="/AddSubject"
                  AddNew_URL_OesRolesList="[OesTemplateRoleConstants.DefinedMaterialCreator]"
                  HideCodeSearch="true"
                  SecondSearchParameterLabel="@Resource.Name">
            <ButtonChildContent Context="value">
                @if (value is SubjectDto subject)
                {
                    <SettingToggle OperationsText="@Resource.Operations">
                        <MudTooltip Text="@Resource.View">
                            <MudFab Color="Color.Primary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.View)}")
                                    StartIcon="@Icons.Material.Filled.Preview"
                                    Size="Size.Small"
                                    OnClick="() => ViewSubjectAsync(subject.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Edit">
                            <MudFab Color="Color.Secondary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Edit)}")
                                    EndIcon="@Icons.Material.Filled.Edit"
                                    Size="Size.Small"
                                    Disabled="@IsEditDisabled(subject)"
                                    OnClick="() => UpdateSubjectAsync(subject.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Delete">
                            <MudFab Color="Color.Error"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Delete)}")
                                    StartIcon="@Icons.Material.Filled.Delete"
                                    Size="Size.Small"
                                    Disabled="@IsDeleteDisabled(subject)"
                                    OnClick="() => DeleteSubjectAsync(subject.Id)" />
                        </MudTooltip>
                    </SettingToggle>
                }
            </ButtonChildContent>
        </ListItem>
    </MudCardContent>
</MudCard>
