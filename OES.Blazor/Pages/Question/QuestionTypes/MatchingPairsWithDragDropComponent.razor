@using OES.Blazor.Components.GenericComponents.TextEditor
@using OES.Helper.Dtos.Question.MatchingPairsWithDragDropQuestion
@using OES.Helper.ResourceFiles
@using OES.Helper.Dtos.Questionlanguage

<EditForm OnSubmit="OnSaveAsync" Model="@ParentQuestionDetails">
    <DataAnnotationsValidator />
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <MudStack Spacing="1" Class="mb-2">
                <MudText Typo="Typo.h6" Class="editor-label-text fw-bold">@Resource.Settings</MudText>
            </MudStack>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg question-settings-card-parent">
                <MudStack Row="true" Spacing="6" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2" Class="question-settings-label mb-0 fw-bold">
                            @Resource.SelectLanguage
                        </MudText>
                        <MudSelect @bind-Value="SelectedLanguage"
                                   Immediate
                                   Dense="true"
                                   Class="rounded-setting-field language-selector"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   ToStringFunc="@(l => l?.Name)"
                                   Error="@(_isSubmitButtonHit && SelectedLanguage.Id == 0)"
                                   Required
                                   AdornmentIcon="@Icons.Material.Filled.Language"
                                   AdornmentColor="Color.Primary"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var language in LanguagesList)
                            {
                                <MudSelectItem Value="language" />
                            }
                        </MudSelect>
                    </MudStack>

                    <MudStack Spacing="0">
                        <NumberLanguageSelector @bind-Value="ParentQuestionDetails.UseArabicNumbers" />
                    </MudStack>

                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body2" Class="question-settings-label mb-0 fw-bold">
                            @Resource.AnswerRandomization:
                        </MudText>
                        <MudCheckBox @bind-Value="ParentQuestionDetails.HasShuffled"
                                     Dense="true"
                                     Color="Color.Primary"
                                     Label="@Resource.RandomizeAnswers"
                                     Class="mt-1" />
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <TextEditor TextEditorParams="ParentQuestionBodyParams" @ref="@ParentQuestionBodyParams.TextEditor">
                 <ActionContent>
                    @if (IsReplaceMode && !string.IsNullOrEmpty(ParentQuestionDetails.AttachmentFileName))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="RemoveBodyMedia">@Resource.RemoveMedia</MudButton>
                    }
                </ActionContent>
            </TextEditor>
        </MudItem>

        <MudItem xs="12">
            <TextEditor TextEditorParams="InstructionsParams" @ref="@InstructionsParams.TextEditor">
                <ActionContent>
                    <MudStack Row="true" Spacing="2">
                        <GeneralLoadingButton EndIcon="@Icons.Material.Filled.CheckCircle"
                                              OnClick="async e => await SaveInstructionAsTemplate()"
                                              ButtonColor="Color.Secondary"
                                              ButtonText="@Resource.SaveAsTemplateInstructions"
                                              Size="Size.Small"
                                              Type="ButtonType.Button" />

                        <GeneralLoadingButton EndIcon="@Icons.Material.Filled.Article"
                                              OnClick="async e => await LoadInstructionTemplate()"
                                              ButtonColor="Color.Surface"
                                              ButtonText="@Resource.LoadTemplates"
                                              Size="Size.Small"
                                              Type="ButtonType.Button" />
                    </MudStack>
                </ActionContent>
            </TextEditor>
        </MudItem>

        <MudItem xs="12">
            <MudDivider Class="my-4" />
        </MudItem>

        <MudItem xs="12" md="12">
            <MudStack Spacing="3">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6" Class="fw-bold"><MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="me-2" />@Resource.Questions</MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddQuestion">@Resource.AddQuestion</MudButton>
                    </MudStack>
                </div>
                <MudAlert Severity="Severity.Info" Dense="true">@Resource.DefineTheQuestions</MudAlert>

                <div>
                    @for (int i = 0; i < QuestionItems.Count; i++)
                    {
                        var index = i;
                        var item = QuestionItems[index];
                        <MudPaper Elevation="1" Class="pa-3 mb-4 border-l-4" Style="border-left: 4px solid var(--mud-palette-primary);">
                            <MudStack Spacing="2">
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="fw-bold">@Resource.Question @(index + 1)</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Class="label-RemoveQuestion"
                                                   Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveQuestion(item))" />
                                </div>
                                <TextEditor TextEditorParams="EditorParamsDict[item.Id]" @ref="EditorParamsDict[item.Id].TextEditor" />
                            </MudStack>
                        </MudPaper>
                    }
                </div>
                <div class="d-flex justify-space-between align-center">
                    <MudStack>
                        <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" OnClick="AddQuestionsTextAsync">@Resource.AddQuestionMenue</MudButton>
                    </MudStack>
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" md="12">
            <MudStack Spacing="3">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6" Class="fw-bold"><MudIcon Icon="@Icons.Material.Filled.PanTool" Class="me-2" />@Resource.Answers</MudText>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="AddAnswer" Disabled="!_isAnswersEnabled">@Resource.AddAnswer</MudButton>
                </div>
                <MudAlert Severity="Severity.Success" Dense="true">@Resource.DefineDraggableAnswersAndLinkThemToQuestions</MudAlert>

                <div>
                    @for (int i = 0; i < AnswerItems.Count; i++)
                    {
                        var index = i;
                        var item = AnswerItems[index];
                        <MudPaper Elevation="1" Class="pa-4 mb-4 border-l-4" Style="border-left: 4px solid var(--mud-palette-secondary);">
                            <MudStack Spacing="3">
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="fw-bold">@Resource.Answer @(index + 1)</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Class=@($"label-{nameof(RemoveAnswer)}")
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveAnswer(item))" />
                                </div>

                                <TextEditor TextEditorParams="EditorParamsDict[item.Id]" @ref="EditorParamsDict[item.Id].TextEditor" />

                                <MudDivider />

                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="fw-bold">@Resource.MatchesQuestion</MudText>
                                    <div style="position: relative;">
                                        <div @onclick="@(() => ToggleDropdown(item.Id))"
                                             class="@(_openDropdownId == item.Id ? "mddc-trigger open" : "mddc-trigger")"
                                             @onmouseenter="@(e => _hoveredTriggerId = item.Id)"
                                             @onmouseleave="@(e => _hoveredTriggerId = 0)">

                                            <div class="mddc-item-body">
                                                @if (CorrectAnswerDict.TryGetValue(item.Id, out var selected) && selected != null)
                                                {
                                                    @((MarkupString)selected.Body)
                                                }
                                                else
                                                {
                                                    <span>@Resource.SelectCorrectQuestion</span>
                                                }
                                            </div>

                                            <MudIcon Icon="@(_openDropdownId == item.Id ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)" />
                                        </div>

                                        @if (_openDropdownId == item.Id)
                                        {
                                            <div @onclick="@(() => _openDropdownId = 0)" />
                                            <div class="mddc-dropdown-list">
                                                <div @onclick="@(() => SelectQuestion(item.Id, null))"
                                                     @onmouseenter="@(e => { _hoveredId = -1; StateHasChanged(); })"
                                                     @onmouseleave="@(e => { _hoveredId = 0; StateHasChanged(); })"
                                                     class="mddc-dropdown-item @(_hoveredId == -1 ? "hovered" : "")">
                                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Class="mddc-icon" Style="color: var(--mud-palette-error);" />
                                                    <div class="mddc-item-body" style="color: var(--mud-palette-error); font-style: italic;">
                                                        @Resource.ClearSelection
                                                    </div>
                                                </div>

                                                <MudDivider Class="my-1" />
                                                @foreach (var q in DropdownQuestionItems)
                                                {
                                                    var isHovered = _hoveredId == q.Id;
                                                    var isSelected = CorrectAnswerDict.TryGetValue(item.Id, out var cur) && cur?.Id == q.Id;

                                                    <div @onclick="@(() => SelectQuestion(item.Id, q))"
                                                         @onmouseenter="@(e => { _hoveredId = q.Id; StateHasChanged(); })"
                                                         @onmouseleave="@(e => { _hoveredId = 0; StateHasChanged(); })"
                                                         class="mddc-dropdown-item @(isSelected ? "selected" : isHovered ? "hovered" : "")">

                                                        <MudIcon Icon="@(isSelected? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                                                 Class="@(isSelected ? "mddc-icon selected" : "mddc-icon")" />

                                                        <div class="mddc-item-body">
                                                            @((MarkupString)q.Body)
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </div>
            </MudStack>
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-center gap-4 mt-8">
            <MudStack Row="true" Spacing="4" Class="w-50">
                <GeneralLoadingButton Class="flex-grow-1 p-2 rounded-pill"
                                      Size="Size.Medium"
                                      IsLoading="@_processing"
                                      ButtonText="@Resource.Save"
                                      EndIcon="@Icons.Material.Filled.CheckCircle"
                                      Type="ButtonType.Submit" />

                <MudButton Variant="Variant.Filled"
                           Size="Size.Medium"
                           Class="flex-grow-1 p-2 rounded-pill"
                           Color="Color.Secondary"
                           OnClick="DialogCancellationCallback"
                           StartIcon="@Icons.Material.Filled.Cancel">
                    @Resource.Cancel
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</EditForm>
