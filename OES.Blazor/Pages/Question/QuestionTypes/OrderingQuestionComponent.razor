@using OES.Blazor.Components.GenericComponents.TextEditor

<EditForm OnSubmit="OnSubmitAsync" Model="@Model">
    <DataAnnotationsValidator />
    <MudGrid Spacing="1">
        <MudItem xs="12">
            <MudStack Spacing="1" Class="mb-2">
                <MudText Typo="Typo.h6" Class="editor-label-text fw-bold">@Resource.Settings</MudText>
            </MudStack>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-lg question-settings-card-parent">
                <MudStack Row="true" Spacing="6" AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body2" Class="question-settings-label mb-0 fw-bold">
                            @Resource.SelectLanguage
                        </MudText>
                        <MudSelect @bind-Value="SelectedLanguage"
                                   Immediate
                                   Dense="true"
                                   Class="rounded-setting-field language-selector"
                                   Style="min-width: 200px;" Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   ToStringFunc="@(l => l?.Name)"
                                   Error="@(_isSubmitButtonHit && SelectedLanguage.Id == 0)"
                                   ErrorText="@_requiredErrorText"
                                   Required
                                   AdornmentIcon="@Icons.Material.Filled.Language"
                                   AdornmentColor="Color.Primary"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var language in LanguagesList)
                            {
                                <MudSelectItem Value="language" />
                            }
                        </MudSelect>
                    </MudStack>

                    <!-- Number Format -->
                    <MudStack Spacing="0">
                        <NumberLanguageSelector @bind-Value="Model.UseArabicNumbers" />
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <TextEditor TextEditorParams="QuestionBodyParams"
                        @ref="@QuestionBodyParams.TextEditor">
                <ActionContent>
                    @if (IsReplaceMode && !string.IsNullOrEmpty(Model.AttachmentFileName))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="RemoveBodyMedia">@Resource.RemoveMedia</MudButton>
                    }
                </ActionContent>
            </TextEditor>
        </MudItem>

        <MudItem xs="12">
            <TextEditor TextEditorParams="InstructionsParams"
                        @ref="@InstructionsParams.TextEditor" />
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.h6" Align="Align.Start">@Resource.QuestionSentences</MudText>
            <MudText Typo="Typo.body2" Color="Color.Info">@Resource.EnterSentencesInCorrectOrder</MudText>
        </MudItem>

        @if (Sentences != null && Sentences.Any())
        {
            @for (int i = 0; i < Sentences.Count; i++)
            {
                var sentence = Sentences[i];
                var index = i;
                <MudItem xs="12" Class="py-1">
                    <MudGrid Spacing="1" Class="align-center">
                        <MudItem xs="11" class="mt-0 py-0">
                            <TextEditor @key="sentence.ComponentGuid"
                                        TextEditorParams="sentence"
                                        @ref="sentence.TextEditor">
                                <ActionContent>
                                    @{
                                        var sentenceData = Model.Choices?.FirstOrDefault(c => c.Id == sentence.CustomId);
                                        if (IsReplaceMode && sentenceData?.HasAttachment == true)
                                        {
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveChoiceMedia(sentence.CustomId)">@Resource.RemoveMedia</MudButton>
                                        }
                                    }
                                </ActionContent>
                            </TextEditor>
                        </MudItem>
                        <MudItem xs="1" Class="py-0">
                            <div class="d-flex flex-column gap-1">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@(index == 0)"
                                                   OnClick="@(() => MoveSentenceUp(index))"
                                                   Title="@Resource.MoveUp" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@(index == Sentences.Count - 1)"
                                                   OnClick="@(() => MoveSentenceDown(index))"
                                                   Title="@Resource.MoveDown" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Variant="Variant.Filled"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   Disabled="@(Model.IsUsedInExam)"
                                                   OnClick="@(() => RemoveSentenceAsync(sentence))"
                                                   Title="@Resource.DeleteChoice" />
                                </div>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            }
        }
        else
        {
            <MudItem xs="12">
                <MudText Align="Align.Center" Typo="Typo.h6" Color="Color.Warning">
                    <strong>@Resource.NoChoicesAddedYet</strong>
                </MudText>
            </MudItem>
        }

        <MudItem xs="12" Class="d-flex flex-column align-center">
            @{
                var areSentencesMoreThanOne = Sentences.Count >= 1 ? Resource.Another : string.Empty;
            }
            <MudFab EndIcon="@Icons.Material.Filled.Add"
                    Label="@string.Format(Resource.AddSentence, areSentencesMoreThanOne)"
                    OnClick="@AddSentence"
                    Color="Color.Primary" />
        </MudItem>

        <MudItem xs="12" Class="d-flex justify-content-center mt-2">
            <MudStack Row="true" Spacing="4" Class="w-50">
                <GeneralLoadingButton Class="flex-grow-1 p-2 rounded-pill"
                                      Size="Size.Small"
                                      ButtonText="@Resource.Save"
                                      IsLoading="@_processing"
                                      EndIcon="@Icons.Material.Filled.CheckCircle"
                                      Type="ButtonType.Submit" />

                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           Class="flex-grow-1 p-2 rounded-pill"
                           Color="Color.Secondary"
                           OnClick="CancelDialogAsync"
                           StartIcon="@Icons.Material.Filled.Cancel">
                    @Resource.Cancel
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</EditForm>
