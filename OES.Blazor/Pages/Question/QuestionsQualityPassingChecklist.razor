@page "/BypassQuestionsQualityCheck"

@using OES.Blazor.Services.Interfaces.Question
@using OES.Helper
@using OES.Helper.Dtos.ItemBank
@using OES.Helper.Dtos.Question
@using OES.Helper.Dtos.Question.QuestionDetailsDtos
@using OES.Helper.Dtos.QuestionCategory
@using OES.Helper.Dtos.QyestionType
@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Enums
@using OES.Helper.Dtos.TreeItem

@attribute [DynamicAuthorizeAttribute(nameof(QuestionsQualityPassingChecklist))]

<PageTitle>@Resource.QuestionsQualityPassingChecklist</PageTitle>

<MudCard Class="mt-4 mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.Checklist" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.QuestionsQualityPassingChecklist</MudText>
        </MudStack>
        <div>
            <ListItem @key="_changingKey"
                      T="PendingQuestionPaginationDto"
                      Caption="@Resource.QuestionsQualityPassingChecklist"
                      CaptionIcon="@Icons.Material.Filled.Checklist"
                      EndpointServerice="BlazQuestionService.GetAllQuestionForPendingOnlyPage"
                      DisplayColumns='[ nameof(PendingQuestionPaginationDto.Code),
                                        nameof(PendingQuestionPaginationDto.TypeDisplay),
                                        nameof(PendingQuestionPaginationDto.Category),
                                        nameof(PendingQuestionPaginationDto.Subject),
                                        nameof(PendingQuestionPaginationDto.ItemBank),
                                        nameof(PendingQuestionPaginationDto.Language),
                                        nameof(PendingQuestionPaginationDto.StatusDisplay) ]'
                      NoConvertColumns='[nameof(PendingQuestionPaginationDto.Code)]'
                      Hide_DescriptionSearch="true"
                      FilterObject="questionFilterPaginationModel"
                      SelectedItems="_selectedQuestions"
                      SelectedItemsChanged="OnSelectedQuestionsChanged"
                      MultiSelection="true">
                <TopChildContent>
                    <MudCard Class="mb-3">
                        <MudCardContent>
                            <MudGrid Justify="Justify.Center">
                                <MudItem xs="12" sm="6" md="3">
                                    <MudSelect T="RootItemBankDto" Label="@Resource.SelectItemBank" Clearable="true" @bind-Value="SelectedItemBank" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                        @if (_itemBanks != null && _itemBanks.Any())
                                        {
                                            @foreach (var itembank in _itemBanks)
                                            {
                                                <MudSelectItem Value="@itembank">@itembank.Name</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudSelect T="QuestionCategoryDto" Label="@Resource.SelectCategory" Clearable="true" @bind-Value="SelectedCategory" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                        @if (_categories != null && _categories.Any())
                                        {
                                            @foreach (var category in _categories)
                                            {
                                                <MudSelectItem Value="@category">@category.Name</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudSelect T="QuestionTypeDto" Label="@Resource.SelectType" @bind-Value="SelectedType" Clearable="true" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                        @if (_questionTypes != null && _questionTypes.Any())
                                        {
                                            @foreach (var type in _questionTypes)
                                            {
                                                <MudSelectItem Value="@type">@(type.Name.ToLocalizedString<QuestionType>())</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>
                                @if (_selectedItemBank != null)
                                {
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudAutocomplete T="TreeItemResponseDto"
                                                         Label="@Resource.SelectBranch"
                                                         Clearable="true"
                                                         @bind-Value="SelectedBranch"
                                                         Variant="Variant.Outlined"
                                                         AnchorOrigin="Origin.BottomCenter"
                                                         SearchFunc="SearchBranches"
                                                         ToStringFunc="@(x => x?.Text)"
                                                         CoerceValue="true"
                                                         ResetValueOnEmptyText="true" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                    <MudFab Class="mt-1 mb-3"
                            Color="Color.Primary"
                            OnClick="ShowBypassConfirmation"
                            StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                            Label="@Resource.BypassQuestions" />
                </TopChildContent>
            </ListItem>
        </div>
    </MudCardContent>
</MudCard>
