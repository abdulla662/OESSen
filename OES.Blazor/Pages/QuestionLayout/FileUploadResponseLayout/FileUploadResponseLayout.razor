

<div class="@(ScreenSizeClass)" data-no-convert>
    <MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="responsive-container d-flex flex-column">
        <MudGrid Spacing="0" Class="sun-editor-editable mb-0 p-0">
            <MudItem xs="@ColumnsCount" data-no-convert>
                <MudText Typo="Typo.inherit" Align="Align.Start" Class="mb-0" data-no-convert>
                    @(new MarkupString(Model.Body))
                </MudText>
            </MudItem>
            @if (Model?.HasAttachment ?? false)
            {
                <MediaAttachment Url="@(Model.AttachmentFileUrl)" />
            }
        </MudGrid>
        <MudGrid Spacing="0" Class="flex-grow-1 mt-0">
            @if (ShowCorrectAnswer)
            {
                <MudItem xs="12" Class="pa-0 ma-0 mt-0">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-0 mb-0 p-0">
                        @Resource.CorrectAnswer
                    </MudText>
                </MudItem>
                <MudItem xs="12"
                         Class="sun-editor-editable pa-0 ma-0"
                         Style="margin-top: 5px !important;">
                    <MudText Typo="Typo.inherit" Class="sun-editor-editable centered-border rounded p-0 mb-0">
                        @(new MarkupString(Model?.ModelAnswer ?? ""))
                    </MudText>
                </MudItem>
            }
        </MudGrid>
        <div class="mt-2">
            <MudButton Disabled="false"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Primary" Class="me-1" />
                @Resource.UploadFile
            </MudButton>
        </div>
    </MudContainer>
</div>
