
<MudContainer MaxWidth="MaxWidth.False">
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">@Resource.QuestionBody</MudText>
        <div class="pa-2 border rounded mud-background-gray">
            @((MarkupString)Model.Body)
        </div>
    </MudPaper>

    @* @if (!string.IsNullOrWhiteSpace(Model.Instructions))
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.subtitle1" Color="Color.Info" Class="mb-2">@Resource.Instructions</MudText>
            <div class="pa-2 border rounded mud-background-gray">
                @((MarkupString)Model.Instructions)
            </div>
        </MudPaper>
    } *@

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" Color="Color.Success" Class="mb-3">@Resource.QuestionSentences (Correct Order)</MudText>
        <MudList T="string">
            @if (Model.Choices != null)
            {
                foreach (var choice in Model.Choices.OrderBy(c => c.OrderId))
                {
                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        @((MarkupString)choice.ChoiceText)
                    </MudListItem>
                }
            }
        </MudList>
    </MudPaper>
</MudContainer>
