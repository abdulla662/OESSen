@* @page "/CreateQuestionType" *@
@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@attribute [DynamicAuthorizeAttribute("CreateQuestionType")]

<EditForm Model="@model">
    <DataAnnotationsValidator />
    <MudCard Class="mx-auto mt-5 w-75 shadow-lg p-4 justify-content-center">
        <MudCardContent>
            <div class="d-flex justify-content-center align-items-center">
                <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" Class="me-2" Style="vertical-align: middle;" />
                <MudText Color="Color.Primary" Typo="Typo.h5" Style="line-height: 1;">
                    @Resource.CreateQuestioType
                </MudText>
            </div>
            <div class="form-group">
                <MudTextField Label="@Resource.Name"
                              @bind-Value="model.Name"
                              For="@(() => model.Name)"
                              Immediate
                              Variant="Variant.Outlined" />
            </div>
        </MudCardContent>

        <div class="form-group w-100 d-flex justify-content-center">
            <MudCardActions Class="mt-4 w-100">
                <GeneralLoadingButton Disabled="@(string.IsNullOrWhiteSpace(model.Name))"
                                      Class="mx-auto w-100"
                                      OnClick="OnValidSubmitAsync"
                                      ButtonColor="Color.Primary"
                                      ButtonText="@Resource.Save"
                                      Type="ButtonType.Submit"
                                      EndIcon="@Icons.Material.Filled.CheckCircle" />
                <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Secondary" Class="w-100 m-2" OnClick="@GoBack" EndIcon="@Icons.Material.Filled.Cancel">@Resource.Cancel</MudButton>
            </MudCardActions>
        </div>
    </MudCard>
</EditForm>
