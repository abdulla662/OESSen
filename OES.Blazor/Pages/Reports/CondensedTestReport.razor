@page "/reports/condensed-test"

@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.Reports.Analytical
@using OES.Helper.ResourceFiles

@attribute [DynamicAuthorizeAttribute("CondensedTestReport")]

<PageTitle>
    @Resource.RptTitleCondensedTest
</PageTitle>

<div class="d-flex justify-content-center align-items-center mb-4 mt-3 ar-no-print">
    <MudIcon Icon="@Icons.Material.Filled.Analytics"
             Color="Color.Primary"
             Size="Size.Large"
             Class="me-2" />
    <MudText Typo="Typo.h5"
             Color="Color.Primary">
        @Resource.RptTitleCondensedTest
    </MudText>
    <ReportInfoButton Title="@Resource.RptTitleCondensedTest" Overview="@_infoOverview" Sections="@_infoSections" />
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error"
              Class="mb-4 ar-no-print"
              ShowCloseIcon="true"
              CloseIconClicked="ClearError">
        @_errorMessage
    </MudAlert>
}

<AnalyticalReportFilter ShowVenue="true"
                        ShowPaper="true"
                        ShowItemBank="false"
                        FilterChanged="OnFilterChangedAsync"
                        OnGenerateClicked="GenerateAsync" />
<div class="d-flex justify-content-end gap-2 mb-3 ar-no-print">
    @if (HasReport)
    {
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.TableChart"
                   Color="Color.Success"
                   OnClick="ExportAsync"
                   Disabled="_isExporting">
            @(_isExporting
                ? Resource.RptExporting
                : Resource.RptExportExcel)
        </MudButton>
    }

    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.Print"
               OnClick="PrintAsync">
        @Resource.RptPrintSaveAsPdf
    </MudButton>
</div>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true"
                         Color="Color.Primary"
                         Class="d-block mx-auto my-8" />
}
else if (HasReport)
{
    <div class="ar-header-info">
        <span>
            <strong>
                @Resource.RptScheduleLabel
            </strong>
            @_report!.Schedule
        </span>
        <span class="ms-4">
            <strong>
                @Resource.RptVenueLabel
            </strong>
            @_report.Venue
        </span>
        <span class="ms-4">
            <strong>
                @Resource.RptPaperLabel
            </strong>
            @_report.PaperCode
        </span>
        @if (_report.ExamDate.HasValue)
        {
            <span class="ms-4">
                <strong>
                    @Resource.RptDateLabel
                </strong>
                @(_report.ExamDate.Value.ToString("yyyy-MM-dd"))
            </span>
        }
    </div>
    <div class="ar-section-title">
        @Resource.RptTestStatistics
    </div>
    <MudPaper Elevation="2"
              Class="pa-3 mb-4 overflow-auto">
        <table class="ar-table">
            <tbody>
                <tr>
                    <td>@Resource.RptTotalPossiblePoints</td>
                    <td>@_report.TotalPossiblePoints</td>
                    <td>@Resource.RptMeanScore</td>
                    <td>@_report.MeanScore</td>
                </tr>
                <tr>
                    <td>@Resource.RptTotalStudents</td>
                    <td>@_report.TotalStudents</td>
                    <td>@Resource.RptMedianScore</td>
                    <td>@_report.MedianScore</td>
                </tr>
                <tr>
                    <td>@Resource.RptMaxScore</td>
                    <td>@_report.MaxScore</td>
                    <td>@Resource.RptStdDeviation</td>
                    <td>@_report.StdDev</td>
                </tr>
                <tr>
                    <td>@Resource.RptMinScore</td>
                    <td>@_report.MinScore</td>
                    <td>@Resource.RptKr20Reliability</td>
                    <td>@_report.Kr20.ToString("F3")</td>
                </tr>
                <tr>
                    <td>@Resource.RptRangeOfScores</td>
                    <td>@_report.RangeOfScores</td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </MudPaper>
    @if (!HasItems)
    {
        <MudAlert Severity="Severity.Info">
            @Resource.RptNoQuestionData
        </MudAlert>
    }
    else
    {
        <div class="ar-section-title">
            @Resource.RptPerItemAnalysis
        </div>
        <MudPaper Elevation="2"
                  Class="pa-0 overflow-auto">
            <table class="ar-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th> @Resource.RptQuestionCode</th>
                        <th> @Resource.RptKey</th>
                        <th>A%</th>
                        <th>B%</th>
                        <th>C%</th>
                        <th>D%</th>
                        <th>E%</th>
                        <th>F%</th>
                        <th>@Resource.RptNonDistractors</th>
                        <th>@Resource.RptCorrectPct</th>
                        <th>@Resource.RptUpper27Pct</th>
                        <th>@Resource.RptLower27Pct</th>
                        <th> @Resource.RptPtBiserial</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in PageItems)
                    {
                        <tr class="@(item.HasDistractorAboveCorrect ? "ar-distractor-alert": string.Empty)">
                            <td>@item.SrNo</td>
                            <td class="ar-text-left">
                                @item.QuestionCode
                            </td>
                            <td>@item.CorrectAnswer</td>
                            <td>@item.FreqA</td>
                            <td>@item.FreqB</td>
                            <td>@item.FreqC</td>
                            <td>@item.FreqD</td>
                            <td>@item.FreqE</td>
                            <td>@item.FreqF</td>
                            <td class="ar-text-left">@item.NonDistractors</td>
                            <td>@item.CorrectPct</td>
                            <td>@item.Upper27Pct</td>
                            <td>@item.Lower27Pct</td>
                            <td>@FormatPointBiserial(item.PointBiserial)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </MudPaper>

        @if (TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-2 ar-no-print">
                <MudText Typo="Typo.caption">@_report.Items.Count item(s_itemsPage â€” page @_itemsPage of @TotalPages</MudText>
                <MudPagination Count="TotalPages" @bind-Selected="_itemsPage" ShowFirstButton="true" ShowLastButton="true" />
            </div>
        }

        <MudText Typo="Typo.caption" Class="mt-2 ar-no-print" Color="Color.Warning">
            @Resource.RptHighlightedRowsNote
        </MudText>
    }
}