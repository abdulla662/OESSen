@page "/ResultGeneration"

@attribute [DynamicAuthorizeAttribute("ResultGeneration")]

@using System.Net
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.EquationTemplate
@using OES.Helper.Dtos.Paper.Responses
@using OES.Helper.Dtos.UserPapersDto
@using OES.Helper.Dtos.Venue.Responses

<MudText Typo="Typo.h4" Align="Align.Center" Class="my-5">@Resource.ResultGeneration</MudText>

@if (_isLoading)
{
    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudStack>
}
else
{
    <MudExpansionPanels MultiExpansion="false">
        <MudExpansionPanel Text="@Resource.Simple" @bind-Expanded="@_isSimpleExpanded">
            <MudDateRangePicker Label="@Resource.Daterange" @bind-DateRange="_dateRange" />
        </MudExpansionPanel>
        <MudExpansionPanel Text="@Resource.Advanced" @bind-Expanded="@_isAdvancedExpanded">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="GetUserPapersDto"
                               Label="@Resource.SelectPaper"
                               MultiSelection="true"
                               SelectedValues="_selectedPapers"
                               SelectedValuesChanged="OnPaperSelectionChanged"
                               ToStringFunc="@(p => p?.Name ?? string.Empty)"
                               Clearable="true">
                        @foreach (var paper in _papers)
                        {
                            <MudSelectItem Value="@paper">@paper.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="GetFormDto"
                               Label="@Resource.SelectForms"
                               MultiSelection="true"
                               SelectedValues="_selectedForms"
                               SelectedValuesChanged="OnFormSelectionChanged"
                               ToStringFunc="@(f => f?.Name ?? string.Empty)"
                               Clearable="true"
                               SelectAll
                               Disabled="@(!_selectedPapers.Any())">
                        @foreach (var form in _forms)
                        {
                            <MudSelectItem Value="@form">@form.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="GetVenueResponseDto"
                               Label="@Resource.SelectVenues"
                               MultiSelection="true"
                               SelectedValues="_selectedVenues"
                               SelectedValuesChanged="OnVenueSelectionChanged"
                               ToStringFunc="@(v => v != null ? $"{v.Name} ({v.Code})" : string.Empty)"
                               SelectAll
                               Clearable="true">
                        @foreach (var venue in _venues)
                        {
                            <MudSelectItem Value="@venue">@venue.Name (@venue.Code)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDateRangePicker Label="@Resource.Daterange" @bind-DateRange="_dateRange" />
                </MudItem>
            </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudStack AlignItems="AlignItems.Center" Class="mt-5">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="GenerateResults"
                   Disabled="@_isGenerating"
                   Size="Size.Large">
            @if (_isGenerating)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@Resource.Processing</MudText>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Class="me-2" />
                @Resource.Generate
            }
        </MudButton>

        @if (_isGenerating)
        {
            <MudPaper Class="pa-6 mt-4" Elevation="2" Style="max-width: 600px; width: 100%;">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudText Typo="Typo.h6" Align="Align.Center" Color="Color.Primary">
                        @Resource.GeneratingResults
                    </MudText>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" Style="width: 100%;" />
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Default">
                        @Resource.ProcessingCandidateData
                    </MudText>
                    <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                        @Resource.ProcessingTimeMayVary
                    </MudText>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mt-2">
                        @Resource.DoNotCloseWhileProcessing
                    </MudAlert>
                </MudStack>
            </MudPaper>
        }
    </MudStack>

    @if (_isGenerated && _exportResults.Any())
    {
        <MudPaper Class="pa-4 mt-5" Elevation="3">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <div>
                    <MudText Typo="Typo.h6" Color="Color.Success">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="me-2" />
                        @Resource.Results
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">
                        @_generationDate
                        (Success: @_exportResults.Count(r => r.IsSuccess), Failed: @_exportResults.Count(r => !r.IsSuccess), Synced: @_exportResults.Count(r => r.IsSynced))
                    </MudText>
                </div>
                <div>
                    @if (_hasCombinedFile)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Class="mr-1"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.FolderZip"
                                   OnClick="@(() => DownloadFileAsync(_combinedFileName, _combinedFileContent))">
                            @_combinedFileName
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Class="mr-1"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.CloudUpload"
                                   OnClick="SendCombinedFileToCTRAsync">
                            @Resource.SentToCTR
                        </MudButton>
                    }

                    @* <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="DownloadAllSuccessfulAsync"
                               Disabled="@(!_exportResults.Any(r => r.IsSuccess))">
                        @Resource.DownloadAll
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.SendAndArchive"
                               OnClick="SyncAllCTRJobsAsync"
                               Disabled="@(!_exportResults.Any(r => r.IsSuccess && !r.IsSynced))">
                        @Resource.SentToCTR
                    </MudButton> *@
                </div>
            </MudStack>

            <MudTable Items="@_exportResults"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0"
                      Class="mt-3">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<ExportResultDto, object>(x => x.FormName)">@Resource.Form</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<ExportResultDto, object>(x => x.VenueName)">@Resource.Venue</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<ExportResultDto, object>(x => x.CandidateCount)">@Resource.Candidates</MudTableSortLabel></MudTh>
                    <MudTh>@Resource.Status</MudTh>
                    <MudTh>@Resource.SyncStatus</MudTh>
                    <MudTh Style="text-align: center;">@Resource.Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Form">
                        <MudText Typo="Typo.body2"><strong>@context.FormName</strong></MudText>
                    </MudTd>
                    <MudTd DataLabel="Venue">
                        <MudText Typo="Typo.body2">@context.VenueName <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.VenueCode</MudChip></MudText>
                    </MudTd>
                    <MudTd DataLabel="Candidates">
                        @if (context.CandidateCount > 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.CandidateCount</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Default">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.IsSuccess)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">@Resource.Ready</MudChip>
                        }
                        else
                        {
                            <MudTooltip Text="@context.ErrorMessage">
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Error">@Resource.Failed</MudChip>
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Sync Status">
                        @if (context.IsSyncing)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Sync">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-1" />
                                @Resource.SyncingProgress
                            </MudChip>
                        }
                        else if (context.IsSynced)
                        {
                            <MudTooltip Text="@($"Sync Job ID: {context.SyncJobId}")">
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CloudDone">@Resource.Synced</MudChip>
                            </MudTooltip>
                        }
                        else if (!context.IsSuccess && string.IsNullOrEmpty(context.ErrorMessage))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Default">-</MudText>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Filled.CloudOff">@Resource.NotSynced</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: center;">
                        @if (context.IsSuccess)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       OnClick="@(() => DownloadFileAsync(context.FileName, context.FileContent))">
                                @Resource.Download
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="@(context.IsSynced ? Color.Success : Color.Default)"
                                       Size="Size.Small"
                                       StartIcon="@(context.IsSyncing ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.SendAndArchive)"
                                       OnClick="@(() => SyncCTRJobAsync(context))"
                                       Disabled="@(context.IsSyncing || context.IsSynced)">
                                @if (context.IsSyncing)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-1" />
                                    <span>@Resource.SyncingProgress</span>
                                }
                                else if (context.IsSynced)
                                {
                                    <span>@Resource.SentToCTR</span>
                                }
                                else
                                {
                                    <span>@Resource.SentToCTR</span>
                                }
                            </MudButton>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">
                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" />
                                @context.ErrorMessage
                            </MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}