@page "/TrackingLogs"

@attribute [DynamicAuthorizeAttribute("TrackingLogs")]

@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Blazor.Models.Results
@using ReviewStatusEnum = OES.Helper.Enums.ReviewStatus

<MudText Typo="Typo.h4" Align="Align.Center" Class="my-5">@Resource.TrackingLogs</MudText>

@if (_isLoading)
{
    <div style="display:flex; justify-content:center; align-items:center; height:60vh; flex-direction:column;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Align="Align.Center">@Resource.Loading</MudText>
    </div>
}
else
{
    <!-- First Part: Candidates Table -->
    <MudPaper Class="pa-4 mb-4">
        <MudTable @ref="_table"
                  ServerData="ServerReload"
                  Hover="true"
                  Striped="true"
                  Dense="true"
                  Elevation="0">
            <ToolBarContent>
                <MudText Typo="Typo.h6">@Resource.CandidatesTrackingLogs</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString"
                              Placeholder="@Resource.Search"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="@(async () => await _table.ReloadServerData())" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UnfinishedCandidateModel, object>(x => x.ExamDate)">@Resource.ExamDate</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UnfinishedCandidateModel, object>(x => x.RegistrationId)">@Resource.RegistrationId</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UnfinishedCandidateModel, object>(x => x.CandidateName)">@Resource.CandidateName</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UnfinishedCandidateModel, object>(x => x.NationalId)">@Resource.NationalId</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UnfinishedCandidateModel, object>(x => x.ExamSeries)">@Resource.Exam</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UnfinishedCandidateModel, object>(x => x.QuestionsAnswered)">@Resource.QuestionsAnswered</MudTableSortLabel>
                </MudTh>
                <MudTh>@Resource.Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Resource.ExamDate">@context.ExamDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="@Resource.RegistrationId">@context.RegistrationId</MudTd>
                <MudTd DataLabel="@Resource.CandidateName">@context.CandidateName</MudTd>
                <MudTd DataLabel="@Resource.NationalId">@context.NationalId</MudTd>
                <MudTd DataLabel="@Resource.Exam">@context.ExamSeries</MudTd>
                <MudTd DataLabel="@Resource.QuestionsAnswered">@context.QuestionsAnswered/@context.TotalQuestions</MudTd>
                <MudTd DataLabel="@Resource.Actions">
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(async () => await ViewCandidateTrackingLogsDetails(context))">
                            @Resource.View
                        </MudButton>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.FileDownload"
                                   OnClick="@(async () => await ExportCandidateAsync(context))">
                            @Resource.ExportExcel
                        </MudButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="[5, 10, 20, 40, 100]"
                               RowsPerPageString="@Resource.RowsPerPage"
                               InfoFormat="@Resource.FromToOfFormat" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}