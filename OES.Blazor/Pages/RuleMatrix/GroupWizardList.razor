@page "/GroupWizardList"
@using OES.Helper.Dtos.CreateTemplate
@using OES.Helper.ResourceFiles

<PageTitle>@Resource.GroupWizard</PageTitle>

<div class="d-flex justify-content-center align-items-center my-5">
    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome"
             Color="Color.Primary"
             Size="Size.Large"
             Class="me-2" />
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-0" Color="Color.Primary">
        @Resource.GroupWizard
    </MudText>
</div>

<ListItem @key="_key"
          T="CreateTemplateDto"
          Caption="Groups"
          EndpointServerice="@FetchAsync"
          DisplayColumns="@DisplayColumns"
          CRUD_Edit_Btn="true"
          CRUD_Delete_Btn="true"
          EditClick_Fun="@(EventCallback.Factory.Create<object>(this, OnEditClickAsync))"
          DeleteClick_fun="DeleteAsync"
          HideCodeSearch="true"
          FirstSearchParameterLabel="Name"
          SecondSearchParameterLabel="@Resource.Description">
    <TopChildContent>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="GoToCreatePage">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="me-1" />
            @Resource.CreateGroupWizard
        </MudButton>
    </TopChildContent>
    <ButtonChildContent Context="value">
        <MudTooltip Text="@Resource.Copy">
            <MudFab Color="Color.Info"
                    StartIcon="@Icons.Material.Filled.ContentCopy"
                    Size="Size.Small"
                    Class="me-2 ms-2"
                    OnClick="@(() => DuplicateAsync(((CreateTemplateDto)value).Id))" />
        </MudTooltip>
    </ButtonChildContent>
</ListItem>