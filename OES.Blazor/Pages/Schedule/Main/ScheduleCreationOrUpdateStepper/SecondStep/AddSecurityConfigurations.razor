@using OES.Blazor.Components.GenericComponents.Loader
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Enums

<MudContainer Class="pa-6" MaxWidth="MaxWidth.ExtraExtraLarge">
    <GeneralLoadingButton EndIcon="@Icons.Material.Filled.Article"
                          Class="mr-5 mb-4 mud-elevation-2"
                          OnClick="ShowTemplatesAsync"
                          ButtonColor="Color.Surface"
                          ButtonText="@Resource.SecurityConfigurationTemplate"
                          Type="ButtonType.Button"
                          Variant="Variant.Filled"
                          Size="Size.Medium" />
    <MudPaper Elevation="3" Class="pa-6 rounded-lg" Width="100%">
        <EditForm Model="@Model" OnSubmit="OnSecondStepSecurityConfigurationsSubmitAsync">
            <DataAnnotationsValidator />
            <MudGrid>
                <!-- Main Configuration Card -->
                <MudItem xs="12">
                    <MudCard Elevation="0" Class="rounded-lg">
                        <MudCardContent>
                            <MudGrid Spacing="3">

                                <!-- Monitoring And Security -->
                                <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-2" />
                                        @Resource.MonitoringAndSecurity
                                    </MudText>
                                    <MudGrid Spacing="2">

                                        @* <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.SecuredBrowser"
                                                       @bind-Value="Model.SecuredBrowser" />
                                        </MudItem> *@

                                        @* <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.EnableLogging"
                                                       @bind-Value="Model.EnableLog" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.DisplayLog"
                                                       @bind-Value="Model.DisplayLog" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.ScreenShots"
                                                       @bind-Value="Model.ScreenShots" />
                                        </MudItem> *@

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.CameraShots"
                                                       @bind-Value="Model.CamShot" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.CandidateCameraShots"
                                                       @bind-Value="Model.CandidateCameraAndCameraShots" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.SupervisorCameraShots"
                                                       @bind-Value="Model.SuperVisorAndCandidateCameraShot" />
                                        </MudItem>

                                        @* <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary" 
                                                       Label="@Resource.CombinedCameraShot" 
                                                       @bind-Value="Model.SuperVisorAndCandidateCombinedCameraShot" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary" 
                                                       Label="@Resource.ScreenshotonFocusOut" 
                                                       @bind-Value="Model.FocusOutWindowsMinimizedScreenShot" />
                                        </MudItem> *@
                                                                               
                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.ProctoringWarnings"
                                                       @bind-Value="Model.ProctoringWarning" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.EnableViolationsDetector"
                                                       @bind-Value="Model.FocusOutWindowsMinimizedCameraShot" />
                                        </MudItem>

                                        @* <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary" 
                                                       Label="@Resource.ShotsonSubmitSkip" 
                                                       @bind-Value="Model.ScreenShotsOnSubmitOrSkip" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary" 
                                                       Label="@Resource.WarnWhenNoFaceDetected" 
                                                       @bind-Value="Model.SystemWarningWhenNoFace" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary" 
                                                       Label="@Resource.AudioRecording" 
                                                       @bind-Value="Model.AudioRecording" />
                                        </MudItem>

                                        <MudItem xs="12" md="6">
                                            <MudSwitch Color="Color.Primary"
                                                       Label="@Resource.EnableProctoring" 
                                                       @bind-Value="Model.Proctoring" />
                                        </MudItem> *@

                                        <MudItem xs="12" md="6">
                                            <MudNumericField @bind-Value="@Model.EvidenceDurationPerSeconds"
                                                             Label="@Resource.EvidenceDurationseconds"
                                                             Variant="Variant.Outlined"
                                                             Error="@(_isSubmitButtonHit && (Model.EvidenceDurationPerSeconds == 0))"
                                                             ErrorText="@Resource.EvidenceDurationMustBeGreaterThanZero"
                                                             Class="mb-3" />
                                        </MudItem>
                                     </MudGrid>
                                </MudItem>

                                @* <MudDivider Class="my-4" /> *@

                                <!-- Access Control -->
                                @* <MudItem xs="12">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3">
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" />
                                        @Resource.AccessControl Settings
                                    </MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" md="6">
                                                <MudSwitch Color="Color.Primary" Label="@Resource.RequireIDCardforcandidate" @bind-Value="Model.IsCandidateIdCardRequired" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                                <MudSwitch Color="Color.Primary" Label="@Resource.PasswordtoCloseApp" @bind-Value="Model.CloseApplicationPasswordRequired" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                                <MudSwitch Color="Color.Primary" Label="@Resource.RestrictAccess" @bind-Value="Model.RestrictAccessRequire" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                                <MudSwitch Color="Color.Primary" Label="@Resource.OnlineExamMode" @bind-Value="Model.IsOnLineExam" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudSelect T="string"
                                                       Label="@Resource.SupportedBrowserVersion"
                                                       @bind-Value="@Model.SupportedVersionForSecuredBrowser"
                                                       Variant="Variant.Outlined"
                                                       Required
                                                       Error="@(_isSubmitButtonHit && (Model.SupportedVersionForSecuredBrowser == null))"
                                                       ErrorText="Browser version is required"
                                                       Clearable>
                                                @foreach (var version in Enum.GetNames<SupportedBrowserVersion>())
                                                {
                                                    <MudSelectItem Value="@version">@version</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem> *@
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Auto Sync Settings -->
                <MudItem xs="12">
                    <MudCard Elevation="0" Class="rounded-lg">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-3">
                                <MudIcon Icon="@Icons.Material.Filled.Sync" Class="mr-2" />
                                @Resource.AutoSyncSettings
                            </MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" md="6">
                                    <MudSwitch Color="Color.Primary"
                                               Label="@Resource.AutoSyncSettings"
                                               @bind-Value="Model.IsAutoSyncEnabled" />
                                </MudItem>
                                @if (Model.IsAutoSyncEnabled)
                                {
                                    <MudItem xs="12" md="6">
                                        <MudTimePicker @bind-Time="_syncScheduleTimeSpan"
                                                       Label="@Resource.SyncScheduleTimeLabel"
                                                       HelperText="@Resource.SyncScheduleTimeDescription"
                                                       AmPm="true"
                                                       Variant="Variant.Outlined"
                                                       Adornment="Adornment.Start"
                                                       AdornmentIcon="@Icons.Material.Filled.AccessTime"
                                                       Clearable="true"
                                                       AnchorOrigin="Origin.TopLeft"
                                                       TransformOrigin="Origin.BottomLeft" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudPaper>
    <GeneralLoadingButton Class="mr-5 mt-4"
                          Disabled="IsSaveTemplateDisabled"
                          OnClick="OpenTemplateNameDialog"
                          EndIcon="@Icons.Material.Filled.CheckCircle"
                          ButtonColor="Color.Secondary"
                          ButtonText="@Resource.SaveConfigurationsAsTemplate"
                          Type="ButtonType.Button"
                          Variant="Variant.Filled"
                          FullWidth="false"
                          Size="Size.Medium" />
</MudContainer>
