@using OES.Blazor.CustomAuthorizationAttribute
@using OES.Helper.Dtos.Venue.Responses
@using OES.Blazor.Components.GenericComponents.SettingToggle
@using OES.Helper.General

@page "/Venues"

@attribute [DynamicAuthorizeAttribute(nameof(VenueList))]

<PageTitle>@Resource.Venues</PageTitle>

<MudCard Class="mt-4 mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Rounded.Place" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.Venues</MudText>
        </MudStack>
        <ListItem @key="VenueKey"
                  T="GetPaginatedVenueResponseDto"
                  EndpointServerice="BlazVenueService.GetAllPaginatedVenuesAsync"
                  Caption="@Resource.Venues"
                  CaptionIcon="@Icons.Material.Filled.Place"
                  DisplayColumns='["Code", "Name", "Address", "PinCode", "TCIdsCount"]'
                  AddNew_URL="/AddVenue"
                  AddNew_URL_OesRolesList="[OesTemplateRoleConstants.VenueCreator]"
                  SecondSearchParameterLabel="@Resource.Name">
            <CustomTopButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           Style="border-radius: 12px;"
                           Class="mb-4 rounded-lg"
                           EndIcon="@Icons.Material.Filled.CloudUpload"
                           OnClick="OpenImportVenuesDialog">
                    @Resource.ImportVenues
                </MudButton>
            </CustomTopButton>
            <ButtonChildContent Context="value">
                @if (value is GetPaginatedVenueResponseDto venue)
                {
                    <SettingToggle OperationsText="@Resource.Operations">
                        <MudTooltip Text="@Resource.View">
                            <MudFab Color="Color.Primary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.View)}")
                                    StartIcon="@Icons.Material.Filled.Preview"
                                    Size="Size.Small"
                                    OnClick="() => OpenViewDialog(venue.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Edit">
                            <MudFab Color="Color.Secondary"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Edit)}")
                                    EndIcon="@Icons.Material.Filled.Edit"
                                    Size="Size.Small"
                                    OnClick="() => NavigateToEditAsync(venue.Id)" />
                        </MudTooltip>
                        <MudTooltip Text="@Resource.Delete">
                            <MudFab Color="Color.Error"
                                    Class=@($"fab-xsmall label-{nameof(Resource.Delete)}")
                                    StartIcon="@Icons.Material.Filled.Delete"
                                    Size="Size.Small"
                                    OnClick="() => DeleteVenueAsync(venue.Id)" />
                        </MudTooltip>
                    </SettingToggle>
                }
            </ButtonChildContent>
        </ListItem>
    </MudCardContent>
</MudCard>