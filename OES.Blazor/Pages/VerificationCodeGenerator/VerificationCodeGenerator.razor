@page "/VerificationCodeGenerator"

@attribute [DynamicAuthorizeAttribute("VerificationCodeGenerator")]

@using OES.Blazor.CustomAuthorizationAttribute

<PageTitle>@Resource.VerificationCodeGenerator</PageTitle>

<MudCard Class="mx-auto mt-5 w-80 shadow-lg p-4 justify-content-center">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Primary" Size="Size.Large" Class="me-2" />
            <MudText Typo="Typo.h4" Color="Color.Primary" Align="Align.Start">@Resource.VerificationCodeGenerator</MudText>
        </MudStack>

        <MudTextField @bind-Value:get="_candidateCode"
                      @bind-Value:set="(string v) => _candidateCode = RemoveWhitespace(v)"
                      Label="@Resource.CandidateCode"
                      Variant="Variant.Outlined"
                      Immediate="true" />

        <MudTextField @bind-Value:get="_registrationNumber"
                      @bind-Value:set="(string v) => _registrationNumber = RemoveWhitespace(v)"
                      Label="@Resource.RegistrationNumber"
                      Variant="Variant.Outlined"
                      Immediate="true" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="GenerateCode"
                   StartIcon="@Icons.Material.Filled.AdsClick"
                   Class="mt-4"
                   FullWidth="true"
                   Disabled="string.IsNullOrWhiteSpace(_registrationNumber) || string.IsNullOrWhiteSpace(_candidateCode)">
            @Resource.GenerateCode
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Surface"
                   OnClick="OpenExportDialogAsync"
                   Class="mt-2"
                   FullWidth="true">
            @Resource.ExportExcel
        </MudButton>

        @if (!string.IsNullOrEmpty(_generatedCode))
        {
            <MudPaper Class="mt-6 pa-6 d-flex flex-column align-center mud-theme-primary rounded-xl" Elevation="4">
                <MudText Typo="Typo.subtitle2" Color="Color.Surface" Class="mb-2">
                    @Resource.GeneratedVerificationCode
                </MudText>

                <MudText Typo="Typo.h2" Color="Color.Surface" Class="my-4 fw-bold" data-no-convert>
                    @_generatedCode
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           OnClick="CopyCodeAsync"
                           StartIcon="@Icons.Material.Filled.ContentCopy"
                           Size="Size.Medium">
                    @_copyButtonText
                </MudButton>
            </MudPaper>
        }
    </MudCardContent>
</MudCard>