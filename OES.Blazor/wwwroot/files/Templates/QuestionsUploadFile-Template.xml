		                          cardinality="single"
		                          identifier="RESPONSE">
			<qti-correct-response>
				<qti-value>False</qti-value>
			</qti-correct-response>
		</qti-response-declaration>
		<qti-item-body>
			<qti-prompt>Chlorine is an example of an alkali metal?</qti-prompt>
			<qti-choice-interaction max-choices="1"
			                        response-identifier="RESPONSE">
				<qti-simple-choice identifier="0">True</qti-simple-choice>
				<qti-simple-choice identifier="0">False</qti-simple-choice>
			</qti-choice-interaction>
		</qti-item-body>
	</qti-assessment-item>
	<qti-assessment-item identifier="0"
				Code="5552"
	                     title="Explain the concept of molarity in a solution.">
		<qti-response-declaration base-type="string"
		                          cardinality="single"
		                          identifier="RESPONSE">
			<qti-correct-response>
				<qti-value>Molarity is the number of moles of solute dissolved in one liter of solution, typically expressed as moles per liter (mol/L).</qti-value>
			</qti-correct-response>
		</qti-response-declaration>
		<qti-item-body>
			<qti-prompt>Explain the concept of molarity in a solution.</qti-prompt>
			<qti-extended-text-interaction response-identifier="RESPONSE"/>
		</qti-item-body>
	</qti-assessment-item>
